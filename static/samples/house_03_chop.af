# house_03_chop — "Chop shop". The sampling workflow: the engine's own rendered loop
# (samples/house_source_loop.wav, pinned by hash) is cut into slices, re-sequenced
# by pattern digits, reversed, time-stretched at constant pitch and bit-crushed.
asset house_03_chop { kind: soundtrack
  duration: 62s
  tempo: 124bpm
  key: F minor
  meter: 4 4
  groove: swing16 0.2
  form: intro 0b for 16b, chop 16b for 80b, outro 96b for 32b
  bus drums {
    fx: comp(threshold=-12, ratio=3, attack=0.004, release=0.08), saturate(amount=0.1)
  }
  bus perc {
    gain: 2db
    fx: plate(decay=0.45, mix=0.25), chorus(rate=0.6, depth=3, delay=12, voices=2, mix=0.3, stereo=1)
  }
  bus chops {
    gain: -2db
    duck: source=kick amount=6db attack=0.008s release=0.2s threshold=-40db
    fx: lowpass(6000hz, q=0.8), saturate(amount=0.12), chorus(rate=0.5, depth=4, delay=14, voices=3, mix=0.45, stereo=1), plate(decay=0.4, mix=0.22)
    auto cutoff: 0s=900, 8s=6000, 31s=8000, 40s=1500, 47s=7000, 62s=700
  }
  layer kick : drums { voice: kick
    bus: drums
    gain: -3db
    decay: 0.5
    snap: 0.6
    pattern: x...x...x...x... }
  layer clap : drums { voice: clap
    bus: perc
    gain: -13db
    pan: -0.35
    pattern: ....x.......x... }
  layer hat : drums { voice: hat
    bus: perc
    gain: -18db
    pan: 0.45
    decay: 0.3
    pattern: ..x...x...x...x. }
  layer chops : sample { file: "house_source_loop.wav"
    sha256: "42bc41e2fe3b5a4995ccf606c5756970fd2958bdc4eb06fcc494572fc82bd8e1"
    bus: chops
    gain: -7db
    pan: 0.15
    slices: 16
    pattern: 0.1.2.3.4.5.6.7.0.1.2.3.c.d.e.f. }
  layer stutter : sample { file: "house_source_loop.wav"
    sha256: "42bc41e2fe3b5a4995ccf606c5756970fd2958bdc4eb06fcc494572fc82bd8e1"
    bus: chops
    gain: -11db
    pan: 0.4
    offset: 0.484s
    length: 0.242s
    slices: 4
    pattern: ....0.1.....2.3.....0.1.....2233
    fx: bitcrush(bits=6, downsample=3, mix=0.6), highpass(300hz) }
  layer reverse_swell : sample { file: "house_source_loop.wav"
    sha256: "42bc41e2fe3b5a4995ccf606c5756970fd2958bdc4eb06fcc494572fc82bd8e1"
    bus: chops
    gain: -10db
    pan: -0.45
    offset: 3.871s
    length: 1.936s
    reverse: on
    stretch: 2
    pattern: x...............x...............x...............x...............
    fx: lowpass(3500hz, q=1.2) }
  layer halftime : sample { file: "house_source_loop.wav"
    sha256: "42bc41e2fe3b5a4995ccf606c5756970fd2958bdc4eb06fcc494572fc82bd8e1"
    bus: chops
    gain: -13db
    pan: -0.2
    pitch: -12st
    stretch: 1.5
    length: 1.936s
    pattern: x...............................................................
    fx: lowpass(1200hz, q=1.0) }
  layer sub : notes { osc: sine
    gain: -9db
    notes: F1 @ 0b for 1b, F1 @ 1.5b for 0.5b, F1 @ 2b for 1b, Ab1 @ 3b for 1b, F1 @ 4b for 1b, F1 @ 5.5b for 0.5b, F1 @ 6b for 1b, C2 @ 7b for 1b,
           Db1 @ 8b for 1b, Db1 @ 9.5b for 0.5b, Db1 @ 10b for 1b, Ab1 @ 11b for 1b, Eb1 @ 12b for 1b, Eb1 @ 13.5b for 0.5b, Eb1 @ 14b for 1b, C2 @ 15b for 1b
    loop: 16b
    env: a=0.005s d=0.2s s=0.7 r=0.1s }
  master { peak: -1db
    lufs: -11
    fx: mbcomp(threshold=-16, ratio=2.5, low=160, high=3000), saturate(amount=0.06) }
}
