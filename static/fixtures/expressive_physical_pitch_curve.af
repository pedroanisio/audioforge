# Acceptance fixture: physical-model pitch curves render via deterministic
# varispeed (tape semantics) — scheduled duration preserved, rate follows
# 2**(cents/1200).

asset expressive_physical_pitch_curve {
  kind: cue
  duration: 1s
  tempo: 120bpm
  layer lead : notes {
    osc: struck
    env: a=0.001s d=0.01s s=0.8 r=0.02s
    notes: A4 @ 0b for 1b
    curves: note 0 pitch_cents basis=note_beats 0b=25c
  }
  master { peak: -1db }
}
