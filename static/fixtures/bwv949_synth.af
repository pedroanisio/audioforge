#   audioforge validate  bwv949.af
#   audioforge render    bwv949.af --preset cinematic_master -o ./renders
#   audioforge render    bwv949.af --preset broadcast        -o ./renders
#   audioforge pack      bwv949.af --variants 4              -o ./packs
#
# Variant suggestion: 4 variants for harpsichord round-robin articulation
# differentiation (the seeded RNG will realize different pluck positions
# per variant while leaving the note IR identical).
# =============================================================================
