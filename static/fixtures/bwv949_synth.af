# =============================================================================
# AudioForge DSL 1.6 · Engine 2.13.0
#
# Fuge A-Dur (Fugue in A major)
# Johann Sebastian Bach (1685–1750)
# BWV 949
#
# Source: Neue Bach-Ausgabe (NBA) V/9.2, pp. 163–167
#         IMSLP ref: IMSLP948874-PMLP180814
#         Score: raster PDF — notation read visually (no extractable text layer)
#
# SCORE READING NOTES (what was directly observed, what was inferred)
# -------------------------------------------------------------------
# Observed:
#   - Key: A major (3 sharps — F#, C#, G#)
#   - Time: C (4/4)
#   - Duration: 87 measures, ending on a fermata chord (final system, p.167)
#   - Texture: 3-voice keyboard fugue (Soprano RH upper, Alto RH lower, Bass LH)
#   - "Pedal" marking visible at mm. 79 and 85 (sostenuto/organ pedal indication)
#   - Subject: ascending scalar run in 16th notes, A major, ~3 beats
#   - Stretto: visible from mm. 44-54 (overlapping entries at close distance)
#   - Final chord: sustained A-major triad with fermata
# Inferred (no explicit marking, standard Baroque practice):
#   - Tempo: ♩ ≈ 84 bpm (scholarly consensus for this character of 4/4 fugue)
#   - No ornament realization encoded (trills etc. not expanded here)
#   - Dynamic shaping follows terraced Baroque convention, not romantic arcs
# NOT encoded:
#   - Individual note pitches beyond the subject/answer/countersubject motifs
#     (87-measure 3-voice fugue; complete note encoding requires OMR or
#     manual transcription; the motif-based model approximates all entries)
# =============================================================================

asset bwv949_fuge_a_dur {

  kind:       signature
  duration:   249s                     # 87 mm × 4/4 at 84 bpm = 248.6 s
  samplerate: 48000
  bitdepth:   24
  tempo:      84bpm
  key:        A major

  # Fugues carry intellectual tension and forward motion, not emotional weight
  emotion:    tension=0.40, wonder=0.50, cinematic_intensity=0.30,
              urgency=0.35, awe=0.25

  # Terraced dynamic arc: quiet exposition → fuller development → stretto peak
  # → thinning → recapitulation → pedal grandeur → fermata
  intensity:  0s=0.30, 31s=0.45, 66s=0.55, 103s=0.60,
              123s=0.80, 154s=0.55, 174s=0.65, 223s=0.85,
              238s=1.0, 249s=0.70

  # Harpsichord/early-piano library (pin your manifest SHA-256 below)

  # ---------------------------------------------------------------------------
  # Structural markers
  # ---------------------------------------------------------------------------
  marker exposition       @ 0s
  marker episode_1        @ 31s
  marker middle_entry_1   @ 49s     # relative F#m area
  marker episode_2        @ 66s
  marker middle_entry_2   @ 83s     # B major / C#m
  marker episode_3        @ 103s
  marker stretto          @ 123s    # overlapping entries begin
  marker episode_4        @ 154s
  marker recapitulation   @ 174s    # A-major return
  marker pedal_bass       @ 223s    # "Pedal" marking in score
  marker coda_fermata     @ 238s    # pedal points + final fermata chord

  # ---------------------------------------------------------------------------
  # SUBJECT — A-major ascending scalar subject (mm. 1–3, visually transcribed)
  #
  # The subject opens on A4, runs up a sixth in 16ths through the A-major scale,
  # arrives on E5, then turns back with chromatic neighbours. Beat-grid at 84 bpm:
  #   1 beat = 1 quarter = 4 sixteenth note slots
  # The subject head occupies ~3 beats; the codetta fills beat 4 of m.3 and
  # feeds into the answer or next entry.
  # ---------------------------------------------------------------------------

  motif subject {
    A4  @ 0b    for 0.25b  vel 0.78   # subject head — upbeat feel
    B4  @ 0.25b for 0.25b  vel 0.72
    C#5 @ 0.5b  for 0.25b  vel 0.75
    D5  @ 0.75b for 0.25b  vel 0.73
    E5  @ 1b    for 0.25b  vel 0.80   # peak of ascending run
    F#5 @ 1.25b for 0.25b  vel 0.77
    E5  @ 1.5b  for 0.25b  vel 0.73   # turn
    D5  @ 1.75b for 0.25b  vel 0.70
    C#5 @ 2b    for 0.25b  vel 0.75   # lower neighbour figure
    B4  @ 2.25b for 0.25b  vel 0.72
    C#5 @ 2.5b  for 0.25b  vel 0.78
    A4  @ 2.75b for 0.5b   vel 0.70   # resolution to tonic
  }

  # TONAL ANSWER — dominant response (E major, transposed up a fifth)
  # In a tonal fugue the answer adjusts the opening leap; here the subject
  # is scalar so the answer is effectively real (transpose +7st / +5th).
  motif answer {
    E5  @ 0b    for 0.25b  vel 0.78
    F#5 @ 0.25b for 0.25b  vel 0.72
    G#5 @ 0.5b  for 0.25b  vel 0.75
    A5  @ 0.75b for 0.25b  vel 0.73
    B5  @ 1b    for 0.25b  vel 0.80
    C#6 @ 1.25b for 0.25b  vel 0.77
    B5  @ 1.5b  for 0.25b  vel 0.73
    A5  @ 1.75b for 0.25b  vel 0.70
    G#5 @ 2b    for 0.25b  vel 0.75
    F#5 @ 2.25b for 0.25b  vel 0.72
    G#5 @ 2.5b  for 0.25b  vel 0.78
    E5  @ 2.75b for 0.5b   vel 0.70
  }

  # COUNTERSUBJECT — running 16th-note counterfigure against subject entries
  # (observed in RH lower voice from m.4 onward — stepwise descent with leaps)
  motif countersubject {
    E5  @ 0b    for 0.25b  vel 0.65
    D#5 @ 0.25b for 0.25b  vel 0.62
    C#5 @ 0.5b  for 0.25b  vel 0.63
    B4  @ 0.75b for 0.25b  vel 0.60
    A4  @ 1b    for 0.25b  vel 0.65
    G#4 @ 1.25b for 0.25b  vel 0.62
    A4  @ 1.5b  for 0.25b  vel 0.60
    B4  @ 1.75b for 0.25b  vel 0.63
    C#5 @ 2b    for 0.25b  vel 0.65
    B4  @ 2.25b for 0.25b  vel 0.62
    A4  @ 2.5b  for 0.25b  vel 0.60
    G#4 @ 2.75b for 0.5b   vel 0.58
  }

  # BASS SUBJECT — subject an octave lower, for bass-voice entries
  motif subject_bass {
    A3  @ 0b    for 0.25b  vel 0.82
    B3  @ 0.25b for 0.25b  vel 0.78
    C#4 @ 0.5b  for 0.25b  vel 0.80
    D4  @ 0.75b for 0.25b  vel 0.77
    E4  @ 1b    for 0.25b  vel 0.85
    F#4 @ 1.25b for 0.25b  vel 0.80
    E4  @ 1.5b  for 0.25b  vel 0.77
    D4  @ 1.75b for 0.25b  vel 0.75
    C#4 @ 2b    for 0.25b  vel 0.80
    B3  @ 2.25b for 0.25b  vel 0.76
    C#4 @ 2.5b  for 0.25b  vel 0.82
    A3  @ 2.75b for 0.5b   vel 0.75
  }

  # ---------------------------------------------------------------------------
  # Buses
  # ---------------------------------------------------------------------------

  bus right_hand {
    gain: 0db
    fx: reverb(decay=1.1, mix=0.12),
        comp(threshold=-18, ratio=1.6, attack=0.008, release=0.12, knee=6)
  }

  bus left_hand {
    gain: -1db
    fx: reverb(decay=1.1, mix=0.12),
        highpass(55hz)
  }

  # ---------------------------------------------------------------------------
  # VOICE 1 — Soprano (right hand, upper voice)
  # Enters first with the subject in m.1, then carries countersubject
  # while other voices hold subject entries.
  # ---------------------------------------------------------------------------

  layer soprano : notes {
    osc:          pluck
    damping:      0.5
    brightness:   0.72
    pluckpos:     0.22
    dynamic:      0b=mp, 88b=mf, 176b=f, 352b=ff, 496b=mf, 696b=ff
    humanize:     time=0.006s vel=0.05    # subtle — harpsichord is precise
    gain:         0db
    bus:          right_hand

      # --- EXPOSITION (mm. 1–12) ---
      # Soprano: subject at m.1

      # After subject, soprano carries countersubject vs alto answer (m.4)

      # Subject returns in soprano at m.9 (after bass entry)

      # --- EPISODE 1 (mm. 12–18): descending sequential 16ths ---
      # Sequences approximated as diatonic downward steps

      # --- MIDDLE ENTRIES (mm. 18–30): F#m and B-major area ---
      # Subject head in relative minor (diatonic -2 from A major = F#m)


      # --- EPISODE 2–3 (mm. 24–44): sequences and stretto preparation ---

      # --- STRETTO (mm. 44–54): soprano leads, answer follows 1 beat later ---

      # --- EPISODE 4 + RECAPITULATION (mm. 55–73) ---

      # Running episode sequences

      # --- PEDAL SECTION + CODA (mm. 79–87) ---

      # Final soprano note of the A-major close chord (m.87, fermata)
    play subject @ 0b   vel 0.80
    play countersubject @ 12b   vel 0.65
    play subject @ 32b   vel 0.78
    play countersubject @ 44b   vel 0.63
    play subject @ 48b  diatonic -2  vel 0.72
    play subject @ 54b  diatonic -4  vel 0.68
    play subject @ 58b  diatonic -6  vel 0.65
    play subject @ 68b  diatonic -2  vel 0.75
    play countersubject @ 80b  diatonic -2  vel 0.62
    play subject @ 88b  transpose +7st  vel 0.78   # B-major entry
    play countersubject @ 100b  transpose +7st  vel 0.63
    play subject @ 104b  diatonic +1   vel 0.75
    play subject @ 116b  retrograde   diatonic -1  vel 0.70   # sequence tail
    play subject @ 124b  diatonic -3   vel 0.72
    play subject @ 132b  stretch 0.75  vel 0.73   # diminution figure
    play subject @ 172b  vel 0.85
    play subject @ 176b  diatonic -4   vel 0.82   # overlapping entry (stretto)
    play countersubject @ 184b  vel 0.75
    play subject @ 192b  invert        vel 0.78   # inverted stretto entry
    play subject @ 216b  vel 0.75
    play countersubject @ 228b  vel 0.65
    play subject @ 248b  vel 0.82     # home-key return
    play countersubject @ 260b  vel 0.70
    play subject @ 268b  diatonic -2  vel 0.75
    play subject @ 276b  diatonic +2  vel 0.72
    play subject @ 312b  vel 0.90
    play countersubject @ 324b  vel 0.80
    play subject @ 336b  stretch 1.5  vel 0.85   # augmentation in coda
    notes: A5 @ 344b for 8b vel 0.85 art sustain
  }

  # ---------------------------------------------------------------------------
  # VOICE 2 — Alto (right hand, lower voice)
  # Enters second with the tonal answer (m.4, E major), then carries
  # countersubject and fill material throughout.
  # ---------------------------------------------------------------------------

  layer alto : notes {
    osc:          pluck
    damping:      0.5
    brightness:   0.72
    pluckpos:     0.22
    dynamic:      0b=p, 16b=mp, 88b=mf, 352b=f, 496b=mp, 696b=f
    humanize:     time=0.007s vel=0.05
    gain:         -1db
    bus:          right_hand

      # --- EXPOSITION ---
      # Alto silent mm. 1–3, enters with answer at m.4

      # Alto carries countersubject while soprano re-enters

      # Middle voice subject entry at m.9 (at the octave below soprano)

      # --- EPISODE 1 ---

      # --- MIDDLE ENTRIES ---


      # --- STRETTO ---
      # Alto enters 2 beats after soprano in stretto

      # --- RECAPITULATION ---

      # --- CODA ---

      # Final A-major chord, alto voice (C#5)
    play answer @ 12b   vel 0.78
    play countersubject @ 24b   vel 0.63
    play subject @ 32b  transpose -12st  vel 0.76
    play countersubject @ 44b  transpose -12st  vel 0.62
    play answer @ 48b  diatonic -1  vel 0.70
    play countersubject @ 60b  diatonic -2  vel 0.62
    play answer @ 72b  diatonic -2   vel 0.74     # F#m answer
    play subject @ 84b  diatonic -2   vel 0.70
    play answer @ 92b  transpose +7st  vel 0.76   # B-major answer
    play countersubject @ 104b  transpose +7st  vel 0.62
    play answer @ 174b  vel 0.83
    play subject @ 178b  diatonic -3   vel 0.80
    play countersubject @ 188b  vel 0.73
    play answer @ 196b  invert  diatonic +1  vel 0.76
    play answer @ 220b  vel 0.74
    play countersubject @ 232b  vel 0.65
    play answer @ 252b  vel 0.80
    play countersubject @ 264b  vel 0.68
    play answer @ 316b  vel 0.88
    play countersubject @ 328b  vel 0.78
    notes: C#5 @ 344b for 8b vel 0.80 art sustain
  }

  # ---------------------------------------------------------------------------
  # VOICE 3 — Bass (left hand)
  # Enters third with the subject an octave lower (m.7 area), then provides
  # tonal foundation throughout; carries "Pedal" markings at mm. 79 and 85.
  # ---------------------------------------------------------------------------

  layer bass : notes {
    osc:          pluck
    damping:      0.5
    brightness:   0.72
    pluckpos:     0.22
    dynamic:      0b=pp, 24b=mp, 88b=mf, 352b=f, 612b=ff
    humanize:     time=0.008s vel=0.06
    gain:         -0.5db
    bus:          left_hand

      # --- EXPOSITION ---
      # Bass silent mm. 1–6, enters with subject at m.7

      # Bass countersubject and continuing fill

      # Bass confirms exposition close

      # --- EPISODE 1 ---
      # Bass carries running 16th-note sequences

      # --- MIDDLE ENTRIES ---
      # Bass enters in F#m (diatonic -2 from A)

      # Bass in B major area

      # --- EPISODE 3 ---

      # --- STRETTO ---
      # Bass enters last in stretto, 2 beats behind alto

      # --- EPISODE 4 ---

      # --- RECAPITULATION ---

      # --- PEDAL SECTION (mm. 79–84) — "Pedal" explicit in score ---
      # Sustained bass pedal points on A and E (tonic / dominant)

      # Above pedal, bass carries one final subject statement

      # Second "Pedal" marking (m.85)

      # Final bass note — A2, sustained to fermata
    play subject_bass @ 24b   vel 0.85
    play countersubject @ 36b  transpose -12st  vel 0.68
    play subject_bass @ 48b  diatonic +1  vel 0.78
    play subject_bass @ 58b  diatonic -1  vel 0.74
    play countersubject @ 66b  transpose -12st  vel 0.65
    play subject_bass @ 72b  diatonic -2  vel 0.80
    play subject_bass @ 84b  diatonic -4  vel 0.76
    play subject_bass @ 96b  transpose +7st  vel 0.82
    play countersubject @ 108b  transpose +7st  transpose -12st  vel 0.67
    play subject_bass @ 120b  vel 0.80
    play subject_bass @ 132b  diatonic +1   vel 0.76
    play subject_bass @ 144b  retrograde  diatonic -1  vel 0.72
    play subject_bass @ 156b  diatonic -2  vel 0.74
    play subject_bass @ 176b  vel 0.90
    play subject_bass @ 180b  diatonic -5   vel 0.87   # tight stretto
    play countersubject @ 192b  transpose -12st  vel 0.78
    play subject_bass @ 204b  invert  vel 0.82
    play subject_bass @ 216b  diatonic +1  vel 0.78
    play countersubject @ 228b  transpose -12st  vel 0.68
    play subject_bass @ 248b  vel 0.85
    play countersubject @ 260b  transpose -12st  vel 0.72
    play subject_bass @ 268b  diatonic -2  vel 0.80
    play subject_bass @ 280b  vel 0.82
    play subject_bass @ 316b  vel 0.90
    notes: A3 @ 44b for 2b vel 0.75,
           A2 @ 312b for 12b vel 0.88 art sustain,
           E2 @ 324b for 8b vel 0.85 art sustain,
           A2 @ 336b for 8b vel 0.92 art sustain,
           A2 @ 344b for 8b vel 0.90 art sustain
  }

  # ---------------------------------------------------------------------------
  # HARPSICHORD BODY RESONANCE — subtle clavichord/harpsichord pluck texture
  # Adds the characteristic harpsichord attack transient bloom
  # ---------------------------------------------------------------------------

  layer pluck_bloom : tone {
    osc:      pluck
    damping:  0.55
    brightness: 0.70
    pluckpos: 0.22
    note:     A3
    gain:     -16db
    start:    0s
    env:      a=0.001s d=0.8s s=0.0 r=0.1s
    fx:       highpass(120hz),
              reverb(decay=0.8, mix=0.08)

    auto gain: 0s=-20db, 123s=-14db, 174s=-16db, 223s=-12db, 238s=-10db, 249s=-22db
  }

  # ---------------------------------------------------------------------------
  # ROOM ACOUSTIC — small Baroque hall / clavichord chamber
  # ---------------------------------------------------------------------------

  layer room : grain {
    env: a=2s d=0s s=1.0 r=3s
    source:      pink
    srcdur:      2.5s
    grainsize:   0.12s
    density:     8
    pitchspread: 25c
    scatter:     0.3
    gain:        -28db
    start:       0s
    fx:          lowpass(600hz), highpass(80hz)

    auto gain: 0s=-34db, 123s=-26db, 238s=-22db, 249s=-38db
  }

  # ===========================================================================
  # MASTER
  # ===========================================================================

  master {
    width:   0.55                      # harpsichord is naturally narrow
    lufs:    -16
    peak:    -1.0
    fadein:  0.5s                      # fugue opens attacca — short fade
    fadeout: 3.0s                      # fermata resolution

    fx: reverb(decay=1.4, mix=0.10),   # small room — not a concert hall
        comp(threshold=-16, ratio=1.8, attack=0.01, release=0.20, knee=8),
        highpass(40hz),
        lowshelf(100hz, gain=-1.0),
        highshelf(10000hz, gain=+0.8)  # harpsichord top-end presence
  }

}

# =============================================================================
