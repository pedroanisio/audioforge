  "diagnostic_codes": {
    "ambiguous_harmony": {
      "repair_hint": "Author an explicit chord symbol (for example C3maj7) so root and quality are not inferred from an ambiguous collection such as C6/Am7."
    },
    "curve_unsupported_voice": {
      "repair_hint": "curve_unsupported_voice"
    },
    "dead_air": {
      "repair_hint": "Fill or trim silent stretches; pass the spec as analysis context so authored rests are not reported as missing audio."
    },
    "duplicate_note_timbre_curve": {
      "repair_hint": "duplicate_note_timbre_curve"
    },
    "fret_out_of_range": {
      "repair_hint": "fret_out_of_range"
    },
    "high_crest": {
      "repair_hint": "Use bus compression, saturation, or lower transient layers."
    },
    "intent_conflict": {
      "repair_hint": "Review typed intent fields against explicit render settings."
    },
    "invalid_curve": {
      "repair_hint": "invalid_curve"
    },
    "loop_boundary_tail": {
      "repair_hint": "Shorten gates or releases so tails end before the loop boundary, or drop loopsafe; the JSON in the message names the measured seam jump and tail energy."
    },
    "lossy_articulation": {
      "repair_hint": "Use MusicXML for notation metadata or accept MIDI loss."
    },
    "low_foundation_weak": {
      "repair_hint": "Check the declared bass part, its register, gain and filtering, or declare expect_bass=false when the piece has no bass by design."
    },
    "mono_image": {
      "repair_hint": "Increase space depth, width, unison spread or pan layers, or declare stereo=mono when a mono image is intended."
    },
    "near_ceiling": {
      "repair_hint": "Use a lower master peak target for delivery headroom."
    },
    "note_curve_unsupported_target": {
      "repair_hint": "note_curve_unsupported_target"
    },
    "note_curve_unsupported_voice": {
      "repair_hint": "note_curve_unsupported_voice"
    },
    "notes_first_event": {
      "repair_hint": "notes_first_event"
    },
    "position_timbre_unsupported": {
      "repair_hint": "position_timbre_unsupported"
    },
    "render_plan_approximation": {
      "repair_hint": "The plan declares an approximate technique, sampled legato join or section multiplication; accept it, or set routing: fallbacks=forbid and use recorded material for the gesture."
    },
    "render_plan_inpaint_unavailable": {
      "repair_hint": "Inpainting is reserved and cannot be routed until F3 lands."
    },
    "render_plan_missing_evidence": {
      "repair_hint": "render_plan_stale"
    },
    "render_plan_policy_fallback_forbid": {
      "repair_hint": "render_plan_policy"
    },
    "render_plan_policy_fallback_warn": {
      "repair_hint": "render_plan_policy"
    },
    "render_plan_schema": {
      "repair_hint": "render_plan_stale"
    },
    "render_plan_stale": {
      "repair_hint": "render_plan_stale"
    },
    "render_plan_stretch_warn": {
      "repair_hint": "render_plan_policy"
    },
    "render_plan_sustain_gap": {
      "repair_hint": "A held sampled note outlasts its recording without a usable loop; shorten the note, pick a region with a sustain loop, or accept the gap."
    },
    "resource_pin": {
      "repair_hint": "resource_pin"
    },
    "scan_requires_morph_osc": {
      "repair_hint": "scan_requires_morph_osc"
    },
    "string_fret_pitch_conflict": {
      "repair_hint": "string_fret_pitch_conflict"
    },
    "string_out_of_tuning": {
      "repair_hint": "string_out_of_tuning"
    },
    "technique_fallback": {
      "repair_hint": "technique_fallback"
    },
    "technique_layer_override": {
      "repair_hint": "technique_layer_override"
    },
    "technique_param_out_of_range": {
      "repair_hint": "technique_param_out_of_range"
    },
    "technique_unknown": {
      "repair_hint": "technique_unknown"
    },
    "technique_unsupported_voice": {
      "repair_hint": "technique_unsupported_voice"
    },
    "tuning_not_rendered": {
      "repair_hint": "The tuning directive is stored but the renderer stays 12-TET; remove it, or wait for the n-EDO resolver (engine 3.1 line) that applies it and proves the frequencies by FFT."
    },
    "tuning_required_for_string_fret": {
      "repair_hint": "tuning_required_for_string_fret"
    },
    "unknown_property": {
      "repair_hint": "unknown_property"
    },
    "unrecognized_harmony": {
      "repair_hint": "The pitch collection matches no known chord quality; notes are kept unchanged. Author a chord symbol or leave the cluster as written."
    },
    "validate_render_ready": {
      "repair_hint": "validate_render_ready"
    },
    "very_bright": {
      "repair_hint": "Lower oscillator brightness, add lowpass automation, or rebalance low layers."
    }
