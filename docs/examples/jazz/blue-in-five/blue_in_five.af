  # ---- PIANO COMP: FM Rhodes (real modulation index), drop-2 stabs ----
  layer comp : notes {
    osc: fm
    fmratio: 1
    fmindex: 1.4
    gain: -13db
    pan: 0.28
    bus: club
    env: a=0.005s d=0.6s s=0.35 r=0.5s
