# =============================================================================
# AudioForge DSL 1.7 · Engine 2.14.0
#
# "Ode to Fable" — Symphony in D
# for Claude Fable 5 (Anthropic), released 2026-06-09
#
# Original composition. generated_by: Claude Opus 4.8 via Claude Code · 2026-06-11
#
# This is an ODE BY DEPICTION, not by cipher: the music does not encode the
# letters of "Fable" — it portrays the model's documented story, the way a tone
# poem honours its subject. Each movement is a programmatic portrait of a real,
# sourced facet of Claude Fable 5:
#
#   I.   MYTHOS              — Largo → Allegro, D minor.
#        Fable 5 is a "Mythos-class" model: the most capable lineage Anthropic
#        has built. A dark four-note cell rises from the depths — vast, powerful,
#        untamed. (anthropic.com/news/claude-fable-5-mythos-5)
#
#   II.  THE TEMPERING       — surge → restraint, G minor → D major.
#        Made safe for general use: in high-risk domains the model holds back
#        and FALLS BACK to Claude Opus 4.8. The Mythos power crests, is
#        restrained, and resolves to a serene descent — the "fallback" voice.
#        (Safeguards trigger in <5% of sessions.)
#
#   III. THE TELLING         — Andante, F major.
#        A fable is a story that teaches. The solo oboe sings the lyric "Fable"
#        theme over warm strings and harp — the heart of the ode.
#
#   IV.  GENERALLY AVAILABLE — Maestoso, D major.
#        Released to the world, 2026-06-09. The storyteller-theme becomes public
#        grandeur; the Mythos cell returns TAMED, now consonant in the major;
#        tubular bells peal the day of release. A hopeful close.
#
# Scored for the Versilian Studios Chamber Orchestra (VSCO-2-CE, CC0), seated
# on a real St Albans Lady Chapel impulse response. Tempo rubato; the section
# times below are the engine's analytic beat→second integral.
#   I 0–42s · II 42–75.5s · III 75.5–130s · IV 130–191s (coda 168s)
# =============================================================================

asset ode_to_fable {

  kind:       soundtrack
  duration:   204s
  samplerate: 48000
  bitdepth:   24

  tempo:      58bpm, 16b=58bpm, 24b=120bpm, 60b=120bpm,
              64b=134bpm, 96b=134bpm, 100b=72bpm, 118b=72bpm,
              120b=69bpm, 180b=69bpm, 184b=116bpm, 248b=116bpm,
              256b=100bpm, 264b=76bpm, 272b=52bpm, 280b=46bpm

  key:        D minor, 100b=D major, 120b=F major, 184b=D major

  emotion:    awe=0.62, wonder=0.55, cinematic_intensity=0.55,
              tension=0.35, calm=0.30

  intensity:  0s=0.25, 20s=0.55, 42s=0.78, 60s=0.88,
              70s=0.34, 76s=0.42, 110s=0.62, 130s=0.80,
              160s=0.95, 168s=1.0, 185s=0.68, 204s=0.35

  library:    "VSCO-2-CE-1.1.0@ff140e8b5c5d6916ccf8088b0fc7dfb632f434d056aa764400905fdbd5824b0e"

  marker mvt1_mythos              @ 0s
  marker mvt2_the_tempering       @ 42s
  marker mvt3_the_telling         @ 76s
  marker mvt4_generally_available @ 130s
  marker coda                     @ 168s

  # ===========================================================================
  # MOTIFS — the ode's three ideas
  # ===========================================================================

  # MYTHOS — a dark rising-fourth cell (the powerful lineage). 4 beats.
  motif mythos {
    D3 @ 0b for 1b vel 0.78
    F3 @ 1b for 1b vel 0.82
    E3 @ 2b for 1b vel 0.76
    A3 @ 3b for 1b vel 0.86
  }

  # FABLE — the storyteller's song (the heart). 8 beats, F major.
  motif fable {
    F4  @ 0b   for 1b   vel 0.70
    A4  @ 1b   for 1b   vel 0.74
    C5  @ 2b   for 1.5b vel 0.82
    Bb4 @ 3.5b for 0.5b vel 0.74
    A4  @ 4b   for 1b   vel 0.76
    G4  @ 5b   for 1b   vel 0.72
    F4  @ 6b   for 2b   vel 0.70
  }

  # OPUS — the calm fallback: a grounding descent to safety. 4 beats.
  motif opus {
    D5 @ 0b for 1b vel 0.60
    C5 @ 1b for 1b vel 0.58
    A4 @ 2b for 1b vel 0.56
    F4 @ 3b for 2b vel 0.54
  }

  # Chord beds (root+octave+quality)
  motif prog_myth   { D3min @ 0b for 2b  Bb2maj @ 2b for 2b  F3maj @ 4b for 2b  A27 @ 6b for 2b }
  motif prog_temper { G3min @ 0b for 2b  Eb3maj @ 2b for 2b  D27 @ 4b for 2b  G3min @ 6b for 2b }
  motif prog_calm   { D3maj @ 0b for 4b  A27 @ 4b for 4b  G3maj @ 8b for 4b  D3maj @ 12b for 4b }
  motif prog_tell   { F3maj7 @ 0b for 2b  D3min7 @ 2b for 2b  Bb2maj7 @ 4b for 2b  C37 @ 6b for 2b }
  motif prog_ga     { D3maj @ 0b for 2b  G3maj @ 2b for 2b  A37 @ 4b for 2b  D3maj @ 6b for 2b }

  # Harp — same harmony voiced open/spread, then arpeggiated
  motif harp_myth { D3min @ 0b for 2b voicing spread  Bb2maj @ 2b for 2b voicing spread  F3maj @ 4b for 2b voicing open  A27 @ 6b for 2b voicing open }
  motif harp_calm { D4maj @ 0b for 4b voicing open  A3maj @ 4b for 4b voicing open  G3maj @ 8b for 4b voicing open  D4maj @ 12b for 4b voicing open }
  motif harp_tell { F4maj7 @ 0b for 2b voicing open  D4min7 @ 2b for 2b voicing open  Bb3maj7 @ 4b for 2b voicing open  C4maj @ 6b for 2b voicing open }
  motif harp_ga   { D4maj @ 0b for 2b voicing spread  G3maj @ 2b for 2b voicing spread  A3maj @ 4b for 2b voicing spread  D4maj @ 6b for 2b voicing spread }

  # Bass roots
  motif bass_myth   { D2 @ 0b for 2b  Bb2 @ 2b for 2b  F2 @ 4b for 2b  A2 @ 6b for 2b }
  motif bass_temper { G2 @ 0b for 2b  Eb2 @ 2b for 2b  D2 @ 4b for 2b  G2 @ 6b for 2b }
  motif bass_calm   { D2 @ 0b for 4b  A2 @ 4b for 4b  G2 @ 8b for 4b  D2 @ 12b for 4b }
  motif bass_tell   { F2 @ 0b for 2b  D2 @ 2b for 2b  Bb2 @ 4b for 2b  C3 @ 6b for 2b }
  motif bass_ga     { D2 @ 0b for 2b  G2 @ 2b for 2b  A2 @ 4b for 2b  D2 @ 6b for 2b }

  # ===========================================================================
  # STAGE — St Albans Lady Chapel IR; a seated orchestra
  # ===========================================================================
  stage {
    hall: "stalbans_ortf_ir.wav@be670d833feaf274e601ad026b4f32f126c71fa8eb9b386e855ed9f0035410aa"
    mics: tree=0.62, close=0.20, ambient=0.42
    size: 22m, 34m, 14m
  }

  # ===========================================================================
  # STRINGS
  # ===========================================================================

  # 1st Violins — the high lineage in I, the storyteller's halo in III, triumph in IV
  layer violins : instrument {
    instrument:   "ViolinEnsSusVib"
    articulation: sustain
    seat:         -25deg @ 5.0m
    dynamic:      0b=p, 24b=mf, 64b=f, 100b=p, 120b=mp, 184b=f, 248b=ff
    vibrato:      rate=5.0 depth=14c delay=0.35s
    phrasing:     0.65
    humanize:     time=0.010s vel=0.06

    # I. Mythos — the cell rises into the violins, an octave up, as the Allegro takes hold
    play mythos @ 24b legato transpose +12st  vel 0.70
    play mythos @ 28b legato transpose +12st  vel 0.74
    play mythos @ 40b legato transpose +12st  vel 0.80
    play mythos @ 48b legato transpose +12st  diatonic +2  vel 0.84
    play mythos @ 56b legato transpose +12st  vel 0.88
    # II. the surge, then the restraint thins the violins to a held tone
    play mythos @ 64b legato transpose +12st  vel 0.86
    play mythos @ 80b legato transpose +12st  diatonic +1  vel 0.90
    notes: A5 @ 96b for 4b vel 0.60,
           D5 @ 256b for 18b vel 0.40, F#5 @ 256b for 18b vel 0.38, A5 @ 256b for 18b vel 0.38
    # III. The Telling — a warm halo above the oboe's song
    play fable @ 136b legato transpose +12st  vel 0.50
    play fable @ 160b legato transpose +12st  vel 0.56
    # IV. Generally Available — the fable theme in public grandeur
    play fable @ 184b legato transpose +12st  vel 0.86
    play fable @ 200b legato transpose +12st  vel 0.92
    play fable @ 216b legato transpose +12st  vel 0.96
    play fable @ 232b legato transpose +12st  vel 1.0
    play fable @ 248b legato transpose +12st  vel 0.90
  }

  # Violas — inner harmony (close, up an octave for clarity)
  layer violas : instrument {
    instrument:   "ViolaEnsSusVib"
    articulation: sustain
    seat:         +8deg @ 5.4m
    dynamic:      0b=p, 24b=mp, 64b=mf, 100b=p, 184b=mf, 248b=f
    vibrato:      rate=4.8 depth=12c delay=0.4s
    humanize:     time=0.012s vel=0.07

    # polish: a soft sustained fifth fills the lull mid-Telling (no drums here)
    notes: D4 @ 144b for 7b vel 0.40, A4 @ 144b for 7b vel 0.38

    play prog_myth @ 16b legato transpose +12st  vel 0.52
    play prog_myth @ 24b legato transpose +12st  vel 0.56
    play prog_myth @ 40b legato transpose +12st  vel 0.62
    play prog_myth @ 56b legato transpose +12st  vel 0.66
    play prog_temper @ 64b legato transpose +12st  vel 0.64
    play prog_temper @ 80b legato transpose +12st  vel 0.70
    play prog_calm @ 100b legato transpose +12st  vel 0.42
    play prog_tell @ 120b legato transpose +12st  vel 0.46
    play prog_tell @ 152b legato transpose +12st  vel 0.50
    play prog_ga @ 184b legato transpose +12st  vel 0.68
    play prog_ga @ 216b legato transpose +12st  vel 0.78
    play prog_ga @ 248b legato transpose +12st  vel 0.74
  }

  # Cellos — the Mythos cell at written pitch in I; counter & open fifths elsewhere
  layer cellos : instrument {
    instrument:   "CelloEnsSusVib"
    articulation: sustain
    seat:         +22deg @ 5.4m
    dynamic:      0b=mp, 64b=f, 100b=p, 120b=mp, 184b=f, 248b=ff
    vibrato:      rate=4.6 depth=12c delay=0.45s
    humanize:     time=0.013s vel=0.07

    # polish: a low sustained D under the coda's glow
    notes: D3 @ 256b for 18b vel 0.44

    # I. Mythos cell from the depths, gathering
    play mythos @ 8b  legato vel 0.66
    play mythos @ 16b legato vel 0.72
    play mythos @ 24b legato vel 0.78
    play mythos @ 40b legato diatonic +2  vel 0.80
    play mythos @ 56b legato vel 0.84
    play mythos @ 64b legato vel 0.86
    # III. a tenor counter-line under the storyteller
    play fable @ 128b legato diatonic -2  vel 0.56
    play fable @ 160b legato diatonic -2  vel 0.60
    # IV. the Mythos cell returns TAMED, now consonant in D major
    play mythos @ 188b legato transpose +2st  vel 0.74
    play mythos @ 204b legato transpose +2st  vel 0.80
    play mythos @ 236b legato transpose +2st  vel 0.86
  }

  # Contrabasses — the tonal foundation
  layer contrabass : instrument {
