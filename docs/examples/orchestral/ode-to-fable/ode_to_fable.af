    play bass_myth @ 0b  legato vel 0.62
    play bass_myth @ 24b legato vel 0.72
    play bass_myth @ 56b legato vel 0.80
    play bass_temper @ 64b legato vel 0.82
    play bass_ga @ 184b legato vel 0.82
    play bass_ga @ 216b legato vel 0.90
    play bass_ga @ 248b legato vel 0.84
  }

  # ===========================================================================
  # PERCUSSION
  # ===========================================================================

  # Timpani — the depths of I, the pillars of II, the thunder of the release
  layer timpani : instrument {
    instrument:   "Timpani"
    articulation: sustain
    seat:         0deg @ 10.0m
    dynamic:      0b=mp, 64b=f, 184b=f, 232b=ff
