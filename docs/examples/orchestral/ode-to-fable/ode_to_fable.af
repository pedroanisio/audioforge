  # ===========================================================================
  # PERCUSSION BANK — cinematic drums, placed ONLY in the silences that want
  # weight (the Largo depths, the surge, the launch into the finale, the
  # release). Gated by start:/duration: so Movement III (the intimate telling)
  # and the gentle coda stay drum-free by construction. Synth voices → dry to
  # master, each with its own space.
  # ===========================================================================

  # I. heartbeat — a deep felt pulse stirring in the Largo depths (fills 0–26s)
  layer heartbeat : drums {
    voice:   tom
    tune:    -7st
    decay:   1.6
    pattern: X.......x.......
    start:   0.5s
    duration: 26s
    gain:    -10db
    fx:      lowpass(170hz), reverb(decay=2.4, mix=0.18)
    auto gain: 0.5s=-20db, 12s=-13db, 24s=-10db, 26s=-16db
  }

  # I→II. building toms drive the Allegro into the Mythos surge (24–62s)
  layer toms_build : drums {
    voice:   tom
    tune:    -3st
    decay:   0.55
    pattern: X..x..X.x..x..X.
    start:   24s
    duration: 38s
    gain:    -12db
    fx:      lowpass(950hz), reverb(decay=1.6, mix=0.13)
    auto gain: 24s=-20db, 40s=-13db, 56s=-9db, 62s=-7db
  }

  # II. a four-square kick under the surge — weight, not groove (42–62s)
  layer kick_drive : drums {
    voice:   kick
    tune:    -2st
    pattern: X...X...X...X...
    start:   42s
    duration: 20s
    gain:    -11db
    fx:      lowpass(420hz)
    auto gain: 42s=-16db, 56s=-9db, 62s=-7db
  }

  # II. a snare roll accelerating into the crest, then cut for the restraint (54–62s)
  layer surge_roll : drums {
    voice:   snare
    snap:    0.6
    pattern: euclid(11,16)
    start:   54s
    duration: 8s
    gain:    -15db
    fx:      highpass(300hz), reverb(decay=1.2, mix=0.20)
    auto gain: 54s=-26db, 60s=-12db, 62s=-9db
  }

  # III→IV. a tom roll crescendos out of the telling and launches the finale (124–130.5s)
  layer launch_roll : drums {
    voice:   tom
    decay:   0.4
    pattern: xxxxxxxxxxxxxxxx
    start:   124s
    duration: 6.5s
    gain:    -15db
    fx:      lowpass(1200hz), reverb(decay=1.4, mix=0.16)
    auto gain: 124s=-28db, 129s=-10db, 130.5s=-6db
  }

  # IV. the engine of the release — kick + toms driving the triumph (130–168s)
  layer finale_kick : drums {
    voice:   kick
    tune:    -2st
    pattern: X...X...X...X...
    start:   130s
    duration: 38s
    gain:    -10db
    fx:      lowpass(450hz), reverb(decay=1.0, mix=0.10)
    auto gain: 130s=-13db, 150s=-8db, 165s=-7db, 168s=-15db
  }

  layer finale_toms : drums {
    voice:   tom
    tune:    -3st
    decay:   0.55
    pattern: X..x..X.x..x..X.
    start:   130s
    duration: 38s
    gain:    -12db
    fx:      lowpass(1000hz), reverb(decay=1.4, mix=0.13)
    auto gain: 130s=-16db, 150s=-9db, 165s=-8db, 168s=-16db
  }

  # IV. snare backbeat lifts the apotheosis, fading before the coda (140–168s)
  layer finale_snare : drums {
    voice:   snare
    snap:    0.5
    pattern: ....X.......X...
    start:   140s
    duration: 28s
    gain:    -15db
    fx:      highpass(250hz), reverb(decay=1.3, mix=0.18)
    auto gain: 140s=-22db, 158s=-12db, 165s=-11db, 168s=-18db
  }

  # Coda. one soft, deep period at the turn into the close — then silence (168–174s)
  layer coda_tom : drums {
    voice:   tom
    tune:    -7st
    decay:   2.0
    pattern: X...............
    start:   168s
    duration: 6s
    gain:    -16db
    fx:      lowpass(150hz), reverb(decay=2.8, mix=0.22)
    auto gain: 168s=-13db, 171s=-20db, 174s=-30db
  }

  # ===========================================================================
  # MASTER — glue + loudness; the stage provides the hall
  # ===========================================================================
  master {
    width:   0.85
    lufs:    -16
    peak:    -1.0
    fadein:  1.5s
    fadeout: 6.5s

    fx: comp(threshold=-17, ratio=2.0, attack=0.02, release=0.25, knee=9, makeup=1),
        highpass(28hz),
        lowshelf(110hz, gain=-1.0),
        highshelf(9000hz, gain=+0.6),
        mbcomp(threshold=-20, ratio=1.8, low=170, high=2700)
  }

}

