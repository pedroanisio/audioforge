    play fable @ 152b legato transpose +12st  vel 0.52
    play fable @ 200b legato transpose +12st  vel 0.64
    play fable @ 232b legato transpose +12st  vel 0.72
  }

  # Oboe — THE storyteller: the solo voice of Movement III, "The Telling"
  layer oboe : instrument {
    instrument:   "OboeSusVib"
    articulation: sustain
    seat:         +4deg @ 7.6m
    dynamic:      120b=mp, 136b=mf, 168b=mp
    vibrato:      rate=5.0 depth=18c delay=0.35s
    phrasing:     0.72
    humanize:     time=0.012s vel=0.07

    play fable @ 120b legato vel 0.72
    play fable @ 136b legato vel 0.76
    play fable @ 152b legato diatonic +2  vel 0.74
    play fable @ 168b legato vel 0.70
    # a tender echo into the finale's arrival
    play fable @ 192b legato vel 0.64
  }

  # Clarinet — the calm "fallback" voice of Movement II; inner colour
  layer clarinet : instrument {
    instrument:   "ClarinetSus"
    articulation: sustain
    seat:         -10deg @ 8.0m
    dynamic:      100b=mp, 120b=p, 184b=mp
    vibrato:      rate=4.6 depth=10c delay=0.4s
    humanize:     time=0.013s vel=0.07

    # II. the descent to safety — the Opus fallback theme
    play opus @ 100b legato vel 0.58
    play opus @ 104b legato vel 0.56
    play opus @ 112b legato diatonic -1  vel 0.54
    # III. a soft countersubject under the oboe
    play fable @ 128b legato diatonic -4  vel 0.46
    play fable @ 160b legato diatonic -2  vel 0.48
    # IV. harmonic filler
    play prog_ga @ 216b transpose +12st  vel 0.50
    play prog_ga @ 240b transpose +12st  vel 0.52
  }

  # Bassoon — the low lineage in I; the descent doubled in II; roots in IV
  layer bassoon : instrument {
    instrument:   "BassoonSus"
    articulation: sustain
    seat:         +12deg @ 8.0m
    dynamic:      0b=p, 64b=mf, 100b=mp, 184b=mf
    humanize:     time=0.014s vel=0.07

    play mythos @ 16b legato vel 0.52
    play mythos @ 40b legato vel 0.58
    play opus @ 104b legato transpose -12st  vel 0.46
    play bass_tell @ 120b legato vel 0.44
    play bass_ga @ 200b legato vel 0.58
    play bass_ga @ 232b legato vel 0.62
  }

  # ===========================================================================
  # BRASS
  # ===========================================================================

  # French horns — the power of the lineage; the noble theme in IV
  layer horns : instrument {
    instrument:   "FHornSus"
    articulation: sustain
    seat:         -16deg @ 9.0m
    dynamic:      0b=p, 40b=mf, 64b=f, 100b=mp, 184b=f, 248b=ff
    humanize:     time=0.013s vel=0.07

    # I–II. the Mythos cell, gathering force
    play mythos @ 32b legato vel 0.60
    play mythos @ 48b legato vel 0.70
    play mythos @ 56b legato vel 0.78
    play mythos @ 64b legato vel 0.82
    play mythos @ 80b legato diatonic +1  vel 0.86
    # IV. the tamed cell + noble harmony
    play mythos @ 188b legato transpose +2st  vel 0.74
    play prog_ga @ 216b legato vel 0.80
    play prog_ga @ 232b legato vel 0.84
    play prog_ga @ 248b legato vel 0.86
  }

  # Trumpet — the cresting surge of II; the blaze of the finale
  layer trumpet : instrument {
    instrument:   "TrumpetSus"
    articulation: sustain
    seat:         +14deg @ 9.0m
    dynamic:      64b=mf, 88b=f, 96b=ff, 184b=f, 232b=ff
    humanize:     time=0.010s vel=0.06

    # II. the power crests — then the restraint cuts it off
    play mythos @ 72b legato transpose +12st  vel 0.72
    play mythos @ 84b legato transpose +12st  diatonic +1  vel 0.82
    play mythos @ 92b legato transpose +12st  vel 0.90
    # IV. the theme blazes
    play fable @ 216b legato vel 0.82
    play fable @ 232b legato vel 0.90
    play fable @ 248b legato vel 0.84
  }

  # Tuba — the depths of the lineage; the pedal of the release
  layer tuba : instrument {
    instrument:   "TubaSus"
    articulation: sustain
    seat:         +20deg @ 9.4m
    dynamic:      0b=mp, 64b=f, 184b=f, 248b=ff
