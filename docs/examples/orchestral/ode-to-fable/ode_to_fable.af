    articulation: sustain
    seat:         +30deg @ 7.0m
    dynamic:      0b=mp, 64b=f, 100b=p, 184b=f, 248b=ff
    humanize:     time=0.014s vel=0.07

    play bass_myth @ 0b  legato vel 0.66
    play bass_myth @ 8b  legato vel 0.70
    play bass_myth @ 24b legato vel 0.78
    play bass_myth @ 40b legato vel 0.80
    play bass_myth @ 56b legato vel 0.84
    play bass_temper @ 64b legato vel 0.82
    play bass_temper @ 80b legato vel 0.86
    play bass_calm @ 100b legato vel 0.48
    play bass_tell @ 120b legato vel 0.50
    play bass_tell @ 152b legato vel 0.54
    play bass_ga @ 184b legato vel 0.84
    play bass_ga @ 216b legato vel 0.92
    play bass_ga @ 248b legato vel 0.86
  }

