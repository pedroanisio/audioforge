    fx: lowshelf(140hz, 2.5), peak(320hz, gain=-1.2, q=1.0), comp(threshold=-18, ratio=1.8, attack=0.02, release=0.22, knee=6), fdn(rt60=3.4, rt60_high=1.4, mix=0.22), saturate(amount=0.1, warmth=0.35)
