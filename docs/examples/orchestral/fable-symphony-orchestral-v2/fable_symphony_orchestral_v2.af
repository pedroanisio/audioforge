# =============================================================================
# AudioForge DSL 1.7 · Engine 2.14.0
#
# "Fable" — Symphony in C, in four movements  (ORCHESTRAL realization, v2)
# An ode to Anthropic Fable
#
# Original composition. generated_by: Claude Opus 4.8 via Claude Code · 2026-06-11
#
# v2 closes the self-inflicted polish gaps of v1 by USING the DSL features I
# had skipped — each verified against the engine before writing:
#   • SPATIALIZATION — a real `stage{}` (St Albans Lady Chapel IR) with every
#       section `seat:`-placed by azimuth + distance. (seat and bus are mutually
#       exclusive — the stage IS the staged layer's bus — so the v1 buses are
#       gone; the hall now provides the common room.)
#   • RUBATO — a tempo map: Allegro I → ritard into Adagio II → Vivace III →
#       broad Maestoso IV → a closing ritardando. Markers, the intensity arc and
#       the duration are set from the engine's analytic beat→second integral.
#   • MODULATION — key map C major → A minor (II) → C major, so the key-aware
#       diatonic transforms actually colour the Adagio in the relative minor.
#   • LEGATO — `legato` on the sustained melodic lines (real sampled legato
#       joins); spiccato/pizz lines stay detached.
#   • VOICING — register-separated strings (violas up an octave, open-fifth
#       cellos) + the `voicing open/spread` keyword on the harp, to kill v1's
#       muddy close clusters.
#   • HARP — the real sampled Harp, now `arp:`-eggiated, not block chords.
#   • TRANSITIONS — dominant pedals + timpani rolls bridge the movement seams.
#
# Tempo map (beat→bpm) and the resulting section times (engine TempoMap):
#   I  0–64b  0.00–37.82s   II 64–128b 37.82–89.34s
#   III 128–192b 89.34–118.66s   IV 192–280b 118.66–185.27s  (coda @ 256b/160.64s)
# =============================================================================

asset fable_symphony_orchestral_v2 {

  kind:       soundtrack
  duration:   192s
  samplerate: 48000
  bitdepth:   24

  # RUBATO — piecewise-linear tempo map (linear ramps between points)
  tempo:      104bpm, 56b=104bpm, 64b=72bpm, 120b=72bpm,
              128b=132bpm, 184b=132bpm, 188b=140bpm, 192b=92bpm,
              248b=92bpm, 256b=84bpm, 264b=66bpm, 272b=52bpm, 280b=44bpm

  # MODULATION — to the relative minor for the Adagio, home for the finale
  key:        C major, 64b=A minor, 128b=C major

  emotion:    wonder=0.65, awe=0.55, calm=0.30,
              cinematic_intensity=0.50, tension=0.20

  # Intensity arc anchored to the real (rubato) section times
  intensity:  0s=0.30, 25s=0.55, 38s=0.28, 65s=0.42,
              89s=0.55, 110s=0.70, 119s=0.72, 150s=0.92,
              161s=1.0, 175s=0.80, 185s=0.55, 192s=0.35

  library:    "VSCO-2-CE-1.1.0@ff140e8b5c5d6916ccf8088b0fc7dfb632f434d056aa764400905fdbd5824b0e"

  marker mvt1_the_kindling   @ 0s
  marker mvt2_the_listening  @ 38s
  marker mvt3_counterpoint   @ 89s
  marker mvt4_fable_entire   @ 119s
  marker coda                @ 161s

  # ===========================================================================
  # MOTIFS
  # ===========================================================================
  motif fable_theme {
    G3 @ 0b    for 0.5b vel 0.70
    C4 @ 0.5b  for 0.5b vel 0.78
    E4 @ 1b    for 0.5b vel 0.80
    G4 @ 1.5b  for 0.5b vel 0.82
    C5 @ 2b    for 1b   vel 0.88
    B4 @ 3b    for 0.5b vel 0.78
    G4 @ 3.5b  for 0.5b vel 0.74
  }

  motif listening {
    A4 @ 0b    for 1b    vel 0.62
    C5 @ 1b    for 0.75b vel 0.66
    B4 @ 1.75b for 0.5b  vel 0.62
    A4 @ 2b    for 1b    vel 0.58
    E4 @ 3b    for 1b    vel 0.55
  }

  # Chord beds — close triads/7ths; violas play these up an octave (transpose +12)
  motif prog_I   { C3maj @ 0b for 2b  G3maj @ 2b for 2b  A3min7 @ 4b for 2b  F3maj7 @ 6b for 2b }
  motif prog_II  { A3min7 @ 0b for 4b  F3maj7 @ 4b for 4b  C3maj7 @ 8b for 4b  G3sus4 @ 12b for 4b }
  motif prog_III { C3maj @ 0b for 1b  A3min7 @ 1b for 1b  D3min7 @ 2b for 1b  G37 @ 3b for 1b }
  motif prog_IV  { C3maj @ 0b for 2b  F3maj7 @ 2b for 2b  G37 @ 4b for 2b  C3maj @ 6b for 2b }

  # Open fifths — clean low harmony for the cellos (no muddy thirds down low)
  motif fifths_I   { C3 @ 0b for 2b  G3 @ 0b for 2b  G2 @ 2b for 2b  D3 @ 2b for 2b  A2 @ 4b for 2b  E3 @ 4b for 2b  F2 @ 6b for 2b  C3 @ 6b for 2b }
  motif fifths_II  { A2 @ 0b for 4b  E3 @ 0b for 4b  F2 @ 4b for 4b  C3 @ 4b for 4b  C3 @ 8b for 4b  G3 @ 8b for 4b  G2 @ 12b for 4b  D3 @ 12b for 4b }
  motif fifths_IV  { C3 @ 0b for 2b  G3 @ 0b for 2b  F2 @ 2b for 2b  C3 @ 2b for 2b  G2 @ 4b for 2b  D3 @ 4b for 2b  C3 @ 6b for 2b  G3 @ 6b for 2b }

  # Harp — same harmony voiced OPEN/SPREAD (the `voicing` keyword), then arpeggiated
  motif harp_I   { C4maj @ 0b for 2b voicing open  G3maj @ 2b for 2b voicing open  A3min7 @ 4b for 2b voicing spread  F3maj7 @ 6b for 2b voicing spread }
  motif harp_II  { A3min7 @ 0b for 4b voicing spread  F3maj7 @ 4b for 4b voicing spread  C4maj7 @ 8b for 4b voicing open  G3sus4 @ 12b for 4b voicing open }
  motif harp_III { C4maj @ 0b for 1b voicing open  A3min7 @ 1b for 1b voicing open  D3min7 @ 2b for 1b voicing open  G37 @ 3b for 1b voicing open }
  motif harp_IV  { C4maj @ 0b for 2b voicing spread  F3maj7 @ 2b for 2b voicing spread  G37 @ 4b for 2b voicing spread  C4maj @ 6b for 2b voicing open }

  motif bass_I   { C2 @ 0b for 2b  G2 @ 2b for 2b  A2 @ 4b for 2b  F2 @ 6b for 2b }
  motif bass_II  { A2 @ 0b for 4b  F2 @ 4b for 4b  C2 @ 8b for 4b  G2 @ 12b for 4b }
  motif bass_III { C2 @ 0b for 1b  A2 @ 1b for 1b  D2 @ 2b for 1b  G2 @ 3b for 1b }
  motif bass_IV  { C2 @ 0b for 2b  F2 @ 2b for 2b  G2 @ 4b for 2b  C2 @ 6b for 2b }

  # ===========================================================================
  # STAGE — St Albans Lady Chapel IR (CC BY 4.0; see ATTRIBUTION in samples/)
  # A seated orchestra: azimuth left(−)/right(+), distance in metres.
  # ===========================================================================
  stage {
    hall: "stalbans_ortf_ir.wav@be670d833feaf274e601ad026b4f32f126c71fa8eb9b386e855ed9f0035410aa"
    mics: tree=0.62, close=0.20, ambient=0.42
    size: 22m, 34m, 14m
  }

  # ===========================================================================
  # STRINGS
  # ===========================================================================

  # 1st Violins — the theme, sung legato; a held dominant bridges I→II
  layer violins : instrument {
    instrument:   "ViolinEnsSusVib"
    articulation: sustain
    seat:         -25deg @ 5.0m
    dynamic:      0b=mp, 64b=p, 192b=f, 256b=ff
    vibrato:      rate=5.0 depth=14c delay=0.35s
    phrasing:     0.65
    humanize:     time=0.010s vel=0.06

    play fable_theme @ 8b   legato vel 0.78
    play fable_theme @ 16b  legato vel 0.82
    play fable_theme @ 24b  legato transpose +12st  vel 0.80
    play fable_theme @ 32b  legato diatonic +2      vel 0.84
    play fable_theme @ 40b  legato vel 0.86
    play fable_theme @ 48b  legato transpose +12st  vel 0.82
    # TRANSITION I→II: a held dominant G, thinning into the Adagio
    notes: G5 @ 58b for 6b vel 0.40
    # II: high sustained answer beneath the oboe (A-minor colour)
    play listening @ 80b  legato stretch 1.5  transpose +12st  vel 0.42
    play listening @ 104b legato stretch 1.5  transpose +12st  vel 0.46
    # IV: grandeur and augmentation
    play fable_theme @ 192b legato transpose +12st  vel 0.90
    play fable_theme @ 200b legato transpose +12st  vel 0.92
    play fable_theme @ 208b legato transpose +12st  vel 0.94
    play fable_theme @ 216b legato transpose +12st  vel 0.96
    play fable_theme @ 224b legato transpose +12st  vel 0.98
    play fable_theme @ 232b legato stretch 2.0  transpose +12st  vel 1.0
    play fable_theme @ 248b legato stretch 2.0  transpose +12st  vel 0.95
  }

  # 1st Violins (spiccato) — the playful diminution of Movement III (detached)
  layer violins_spic : instrument {
    instrument:   "ViolinEnsSpic"
    articulation: sustain
    seat:         -22deg @ 5.2m
    dynamic:      128b=mp, 176b=mf
    humanize:     time=0.012s vel=0.08

    play fable_theme @ 130b stretch 0.5  vel 0.78
    play fable_theme @ 134b stretch 0.5  diatonic +1      vel 0.78
    play fable_theme @ 138b stretch 0.5  retrograde       vel 0.76
    play fable_theme @ 144b stretch 0.5  transpose +12st  vel 0.80
    play fable_theme @ 150b stretch 0.5  diatonic +1      vel 0.76
    play fable_theme @ 156b stretch 0.5  diatonic +2      vel 0.80
    play fable_theme @ 164b stretch 0.5  vel 0.82
    play fable_theme @ 172b stretch 0.5  transpose +12st  vel 0.84
    play fable_theme @ 180b stretch 0.5  diatonic +3      vel 0.84
    play fable_theme @ 186b stretch 0.5  vel 0.86
  }

  # Violas — inner harmony, an octave up for clarity (legato), close voicing
  layer violas : instrument {
    instrument:   "ViolaEnsSusVib"
    articulation: sustain
    seat:         +8deg @ 5.4m
    dynamic:      0b=mp, 64b=p, 192b=mf, 256b=f
    vibrato:      rate=4.8 depth=12c delay=0.4s
    humanize:     time=0.012s vel=0.07

    play prog_I @ 0b   legato transpose +12st  vel 0.58
    play prog_I @ 8b   legato transpose +12st  vel 0.60
    play prog_I @ 16b  legato transpose +12st  vel 0.62
    play prog_I @ 24b  legato transpose +12st  vel 0.64
    play prog_I @ 32b  legato transpose +12st  vel 0.66
    play prog_I @ 40b  legato transpose +12st  vel 0.64
    play prog_I @ 48b  legato transpose +12st  vel 0.62
    play prog_I @ 56b  legato transpose +12st  vel 0.56
    play prog_II @ 64b  legato transpose +12st  vel 0.44
    play prog_II @ 80b  legato transpose +12st  vel 0.46
    play prog_II @ 96b  legato transpose +12st  vel 0.50
    play prog_II @ 112b legato transpose +12st  vel 0.46
    play prog_IV @ 192b legato transpose +12st  vel 0.70
    play prog_IV @ 208b legato transpose +12st  vel 0.76
    play prog_IV @ 224b legato transpose +12st  vel 0.82
    play prog_IV @ 240b legato transpose +12st  vel 0.86
    play prog_IV @ 256b legato transpose +12st  vel 0.74
  }

  # Cellos — clean open-fifth foundation (legato) + a counter-line in IV
  layer cellos : instrument {
    instrument:   "CelloEnsSusVib"
    articulation: sustain
    seat:         +22deg @ 5.4m
    dynamic:      0b=mp, 64b=p, 192b=mf, 256b=f
    vibrato:      rate=4.6 depth=12c delay=0.45s
    humanize:     time=0.013s vel=0.07

    play fifths_I @ 0b   legato vel 0.56
    play fifths_I @ 16b  legato vel 0.60
    play fifths_I @ 32b  legato vel 0.64
    play fifths_I @ 48b  legato vel 0.58
    play fifths_II @ 64b  legato vel 0.46
    play fifths_II @ 96b  legato vel 0.50
    # IV: tenor counter-melody under the augmented theme
    play fable_theme @ 194b legato invert  vel 0.66
    play fable_theme @ 210b legato diatonic -2  vel 0.70
    play fable_theme @ 226b legato invert  vel 0.72
    play fifths_IV @ 240b legato vel 0.74
    play fifths_IV @ 256b legato vel 0.64
  }

  # Contrabasses — the tonal foundation (sustain) in I/II/IV
  layer contrabass : instrument {
    instrument:   "ContrabassSusVB"
    articulation: sustain
    seat:         +30deg @ 7.0m
    dynamic:      0b=mp, 64b=p, 192b=f, 256b=ff
    humanize:     time=0.014s vel=0.07

    play bass_I @ 0b   legato vel 0.72
    play bass_I @ 16b  legato vel 0.74
    play bass_I @ 32b  legato vel 0.78
    play bass_I @ 48b  legato vel 0.74
    play bass_II @ 64b  legato vel 0.56
    play bass_II @ 96b  legato vel 0.60
    play bass_IV @ 192b legato vel 0.84
    play bass_IV @ 208b legato vel 0.88
    play bass_IV @ 224b legato vel 0.92
    play bass_IV @ 240b legato vel 0.96
    play bass_IV @ 256b legato vel 0.84
  }

  # Contrabasses (pizzicato) — the walking foundation of the scherzo
  layer contrabass_pizz : instrument {
    instrument:   "ContrabassPizz"
    articulation: sustain
    seat:         +30deg @ 7.2m
    dynamic:      128b=mp, 176b=mf
    humanize:     time=0.012s vel=0.08

    play bass_III @ 128b vel 0.72
    play bass_III @ 136b vel 0.74
    play bass_III @ 144b vel 0.76
    play bass_III @ 152b vel 0.76
    play bass_III @ 160b vel 0.78
    play bass_III @ 168b vel 0.80
    play bass_III @ 176b vel 0.80
    play bass_III @ 184b vel 0.82
  }

  # ===========================================================================
  # WOODWINDS
  # ===========================================================================

  layer flute : instrument {
    instrument:   "FluteSusVib"
    articulation: sustain
    seat:         -6deg @ 7.6m
    dynamic:      0b=p, 32b=mf, 192b=f
    vibrato:      rate=5.4 depth=16c delay=0.3s
    phrasing:     0.6
    humanize:     time=0.011s vel=0.06

    play fable_theme @ 32b  legato transpose +12st  vel 0.62
    play fable_theme @ 40b  legato transpose +12st  vel 0.66
    play fable_theme @ 144b stretch 0.5  transpose +12st  vel 0.58
    play fable_theme @ 172b stretch 0.5  transpose +12st  vel 0.62
    play fable_theme @ 180b stretch 0.5  transpose +12st  vel 0.62
    play fable_theme @ 208b legato transpose +12st  vel 0.70
    play fable_theme @ 224b legato transpose +12st  vel 0.74
    play fable_theme @ 232b legato stretch 2.0  transpose +12st  vel 0.78
  }

  # Oboe — the solo voice of the Adagio (legato), in A-minor colour
  layer oboe : instrument {
    instrument:   "OboeSusVib"
    articulation: sustain
    seat:         +4deg @ 7.6m
    dynamic:      64b=mp, 96b=mf, 128b=p
    vibrato:      rate=5.0 depth=18c delay=0.35s
    phrasing:     0.72
    humanize:     time=0.012s vel=0.07

    play listening @ 66b  legato stretch 1.5  vel 0.66
    play listening @ 76b  legato stretch 1.5  diatonic +1  vel 0.68
    play listening @ 88b  legato stretch 1.5  vel 0.70
    play listening @ 100b legato stretch 1.25 invert       vel 0.64
    play listening @ 112b legato stretch 1.5  vel 0.60
    play fable_theme @ 200b legato transpose +12st  vel 0.66
    play fable_theme @ 216b legato transpose +12st  vel 0.70
  }

  layer clarinet : instrument {
    instrument:   "ClarinetSus"
    articulation: sustain
    seat:         -10deg @ 8.0m
    dynamic:      64b=p, 128b=mp, 192b=mf
    vibrato:      rate=4.6 depth=10c delay=0.4s
    humanize:     time=0.013s vel=0.07

    play listening @ 70b  legato stretch 1.5  diatonic -2  vel 0.46
    play listening @ 92b  legato stretch 1.5  invert  diatonic -2  vel 0.48
    play fable_theme @ 132b stretch 0.5  diatonic -2  vel 0.60
    play fable_theme @ 152b stretch 0.5  diatonic -1  vel 0.60
    play fable_theme @ 168b stretch 0.5  diatonic -1  vel 0.62
    play prog_IV @ 208b transpose +12st  vel 0.50
    play prog_IV @ 240b transpose +12st  vel 0.54
  }

  # Bassoon — low woodwind; doubles the bass and bridges II→III with a dominant
  layer bassoon : instrument {
    instrument:   "BassoonSus"
    articulation: sustain
    seat:         +12deg @ 8.0m
    dynamic:      0b=p, 128b=mp, 192b=mf
    humanize:     time=0.014s vel=0.07

    play bass_I @ 0b   legato vel 0.50
    play bass_I @ 32b  legato vel 0.54
    # TRANSITION II→III: a sustained dominant E (under A minor) into the scherzo
    notes: E3 @ 122b for 6b vel 0.44
    play bass_III @ 128b vel 0.56
    play bass_III @ 160b vel 0.60
    play fable_theme @ 202b legato invert  vel 0.58
    play fable_theme @ 234b legato stretch 2.0  invert  vel 0.62
  }

  # ===========================================================================
  # BRASS
  # ===========================================================================

  layer trumpet : instrument {
    instrument:   "TrumpetSus"
    articulation: sustain
    seat:         +14deg @ 9.0m
    dynamic:      0b=mf, 8b=p, 192b=f, 232b=ff
    humanize:     time=0.010s vel=0.06

    play fable_theme @ 0b   legato vel 0.72
    play fable_theme @ 4b   legato diatonic +4  vel 0.64
    play fable_theme @ 216b legato vel 0.84
    play fable_theme @ 224b legato vel 0.88
    play fable_theme @ 232b legato stretch 2.0  vel 0.94
    play fable_theme @ 248b legato stretch 2.0  vel 0.86
  }

  # French horns — warm chordal weight (legato); a swell bridges III→IV
  layer horns : instrument {
    instrument:   "FHornSus"
    articulation: sustain
    seat:         -16deg @ 9.0m
    dynamic:      0b=p, 48b=mf, 188b=mf, 192b=f, 248b=ff
    humanize:     time=0.013s vel=0.07

    play prog_I @ 32b  legato vel 0.54
    play prog_I @ 40b  legato vel 0.58
    play prog_I @ 48b  legato vel 0.54
    # TRANSITION III→IV: a rising dominant swell into the finale
    notes: G3 @ 188b for 4b vel 0.50
    play fable_theme @ 192b legato vel 0.74
    play fable_theme @ 200b legato vel 0.78
    play fable_theme @ 208b legato vel 0.82
    play prog_IV @ 232b legato vel 0.86
    play prog_IV @ 248b legato vel 0.90
    play prog_IV @ 256b legato vel 0.78
  }

  layer tuba : instrument {
    instrument:   "TubaSus"
    articulation: sustain
    seat:         +20deg @ 9.4m
    dynamic:      192b=f, 248b=ff
    humanize:     time=0.015s vel=0.07

    play bass_IV @ 192b legato vel 0.74
    play bass_IV @ 208b legato vel 0.80
    play bass_IV @ 224b legato vel 0.86
    play bass_IV @ 240b legato vel 0.92
    play bass_IV @ 256b legato vel 0.80
  }

  # ===========================================================================
  # PERCUSSION
  # ===========================================================================

  # Timpani — pillars and the apotheosis, plus the transition rolls at the seams
  layer timpani : instrument {
    instrument:   "Timpani"
    articulation: sustain
    seat:         0deg @ 10.0m
    dynamic:      0b=mf, 192b=f, 232b=ff
    humanize:     time=0.008s vel=0.06

    notes: C2 @ 0b for 1b vel 0.78, G2 @ 2b for 1b vel 0.64,
           C2 @ 32b for 1b vel 0.70,
           G2 @ 60b for 4b vel 0.40, G2 @ 124b for 4b vel 0.44,
           C2 @ 188b for 4b vel 0.62,
           C2 @ 192b for 1b vel 0.82, G2 @ 196b for 1b vel 0.74,
           C2 @ 200b for 1b vel 0.84, C2 @ 232b for 2b vel 0.92,
           G2 @ 240b for 1b vel 0.84, C2 @ 248b for 2b vel 0.94,
           C2 @ 264b for 2b vel 0.80
  }

  layer glockenspiel : instrument {
    instrument:   "Glockenspiel"
    articulation: sustain
    seat:         -8deg @ 9.6m
    dynamic:      0b=mf, 192b=f

    notes: C6 @ 0b for 2b vel 0.74, G5 @ 32b for 2b vel 0.58,
           C6 @ 192b for 2b vel 0.66, E6 @ 208b for 2b vel 0.66,
           G6 @ 224b for 2b vel 0.70, C7 @ 232b for 4b vel 0.74,
           C6 @ 264b for 4b vel 0.60
  }

  layer tubular : instrument {
    instrument:   "TubularBells"
    articulation: sustain
    seat:         +8deg @ 9.6m
    dynamic:      192b=f, 232b=ff

    notes: C5 @ 192b for 4b vel 0.72, G4 @ 200b for 4b vel 0.66,
           C5 @ 232b for 8b vel 0.84, G5 @ 248b for 8b vel 0.78,
           C5 @ 264b for 8b vel 0.70
  }

  # Harp — voiced OPEN/SPREAD and ARPEGGIATED across the whole arc
  layer harp : instrument {
    instrument:   "Harp"
    articulation: sustain
    seat:         -18deg @ 4.6m
    arp:          up rate=0.25b octaves=2 gate=0.9
    humanize:     time=0.010s vel=0.08

    play harp_I @ 16b  vel 0.56
    play harp_I @ 24b  vel 0.58
    play harp_I @ 32b  vel 0.60
    play harp_I @ 40b  vel 0.60
    play harp_I @ 48b  vel 0.58
    play harp_II @ 64b  vel 0.44
    play harp_II @ 96b  vel 0.48
    play harp_III @ 128b vel 0.56
    play harp_III @ 144b vel 0.60
    play harp_III @ 160b vel 0.62
    play harp_III @ 176b vel 0.64
    play harp_IV @ 192b vel 0.64
    play harp_IV @ 208b vel 0.68
    play harp_IV @ 224b vel 0.72
    play harp_IV @ 240b vel 0.76
    play harp_IV @ 256b vel 0.64
  }

  # ===========================================================================
  # MASTER — glue + loudness only; the stage provides the hall
  # ===========================================================================
  master {
    width:   0.85
    lufs:    -16
    peak:    -1.0
    fadein:  1.0s
    fadeout: 6.0s

    fx: comp(threshold=-17, ratio=2.0, attack=0.02, release=0.25, knee=9, makeup=1),
        highpass(28hz),
        lowshelf(110hz, gain=-1.0),
        highshelf(9000hz, gain=+0.6),
        mbcomp(threshold=-20, ratio=1.8, low=170, high=2700)
  }

}

