           D5 @ 264b for 8b vel 0.70
  }

  # ===========================================================================
  # PERCUSSION (synth) — sparing: a depths heartbeat + one launch roll only.
  # ===========================================================================

  # I. a deep felt pulse stirring in the Largo depths
  layer heartbeat : drums {
    voice:   tom
    tune:    -7st
    decay:   1.6
    pattern: X.......x.......
    start:   1s
    duration: 18s
    gain:    -12db
    fx:      lowpass(170hz), reverb(decay=2.4, mix=0.18)
    auto gain: 1s=-22db, 10s=-14db, 18s=-20db
  }

  # III->IV. a tom roll crescendos out of the telling and launches the finale
  layer launch_roll : drums {
    voice:   tom
    decay:   0.4
    pattern: xxxxxxxxxxxxxxxx
    start:   127s
    duration: 6s
    gain:    -15db
    fx:      lowpass(1200hz), reverb(decay=1.4, mix=0.16)
    auto gain: 127s=-28db, 132s=-11db, 133s=-7db
  }

  # ===========================================================================
  # MASTER
  # ===========================================================================
  master {
    width:   0.85
    lufs:    -16
    peak:    -1.0
    fadein:  1.5s
    fadeout: 6.5s

    fx: comp(threshold=-17, ratio=2.0, attack=0.02, release=0.25, knee=9, makeup=1),
        highpass(28hz),
        lowshelf(110hz, gain=-1.0),
        highshelf(9000hz, gain=+0.6),
        mbcomp(threshold=-20, ratio=1.8, low=170, high=2700)
  }

}

