# =============================================================================
# AudioForge DSL 1.7 · Engine 2.14.0
#
# "Ode to Fable" — Symphony in D  (SYMPHONIC REWRITE)
# for Claude Fable 5 (Anthropic), released 2026-06-09
#
# Original composition. generated_by: Claude Opus 4.8 via Claude Code · 2026-06-11
#
# This rewrite answers a craft critique of the first version: stop PLACING three
# motifs as labels and instead METABOLIZE one cell into the whole work, develop
# it, and make D minor EARN its way to D major across the entire arc.
#
# ONE CELL — everything is born from it:
#   MYTHOS = D F E A, rhythm short-short-short-LONG  (intervals: m3, semitone, P4)
#     • FABLE  is DERIVED from it — same contour & rhythm-echo, the minor 3rd
#       lifted to major, then a lyric fall (F A G C / Bb A F).
#     • OPUS   is MYTHOS INVERTED — the calming descent IS the lineage turned
#       inward (D B C G -> D).
#     • The RHYTHM (short-short-short-LONG) is itself a motif: the timpani hammers
#       it as a "destiny" tag on D and the dominant A.
#
# THE ARGUMENT (earned D minor -> D major):
#   I.   MYTHOS         — the cell cannot cadence; D minor, deceptive endings.
#   DEV. THE ARGUMENT   — fragmentation, inversion, compression, augmentation,
#                         and a contrapuntal CONFLICT of all three motifs at once.
#   II.  THE TEMPERING  — the great A7 dominant is reached and WITHDRAWN (the
#                         fallback); OPUS interrupts; the key refuses to resolve.
#   III. THE TELLING    — FABLE humanizes the material in F major, but an A pedal
#                         lurks and deceptive cadences keep denying D.
#   IV.  GENERALLY AVAILABLE — the prepared A7 FINALLY resolves to D MAJOR; FABLE
#                         and MYTHOS combine; the cell turns bright (F#).
#   CODA — the opening cell returns as D F# E A over D major: the dissonant F
#          lifted to F#, the same four notes, resolved FROM WITHIN.
#
# Harmony is deliberately less trailer-functional: diminished pivots, chromatic
# mediants (Eb, Gb), modal mixture (Bb minor), dominant-pedal pressure, and
# deceptive resolutions. Percussion is motivic (timpani = the rhythm cell), not
# propulsion. Scored for VSCO-2-CE on a St Albans Lady Chapel IR.
#
# Section times (engine beat->second integral, with rubato):
#   I 0–31.7s · DEV 31.7–49.4s · II 49.4–80.1s · III 80.1–133s · IV 133–172s
#   coda 172s
# =============================================================================

asset ode_to_fable_symphonic {

  kind:       soundtrack
  duration:   206s
  samplerate: 48000
  bitdepth:   24

  tempo:      56bpm, 12b=56bpm, 20b=126bpm, 44b=126bpm,
              48b=138bpm, 84b=138bpm, 88b=92bpm, 108b=92bpm,
              112b=66bpm, 126b=66bpm, 128b=63bpm, 182b=63bpm,
              184b=112bpm, 248b=112bpm, 256b=96bpm, 264b=72bpm,
              272b=52bpm, 280b=46bpm

  # The tonal argument: D minor must fight to D major. Mixture and the brief
  # F-major "telling" are stations on the way; the finale earns the major.
  key:        D minor, 128b=F major, 184b=D major

  emotion:    awe=0.60, wonder=0.52, cinematic_intensity=0.52,
              tension=0.45, calm=0.28

  intensity:  0s=0.22, 15s=0.50, 32s=0.78, 45s=0.92,
              49s=0.70, 60s=0.88, 64s=0.30, 80s=0.40,
              115s=0.60, 133s=0.80, 162s=0.97, 172s=1.0,
              185s=0.60, 206s=0.30

  library:    "VSCO-2-CE-1.1.0@ff140e8b5c5d6916ccf8088b0fc7dfb632f434d056aa764400905fdbd5824b0e"

  marker mvt1_mythos              @ 0s
  marker dev_the_argument         @ 32s
  marker mvt2_the_tempering       @ 49s
  marker mvt3_the_telling         @ 80s
  marker mvt4_generally_available @ 133s
  marker coda                     @ 172s

  # ===========================================================================
  # THE CELL AND ITS DERIVATIVES
  # ===========================================================================

  # MYTHOS — the generative cell. Rhythm = short-short-short-LONG.
  motif mythos       { D3 @ 0b for 0.5b vel 0.80  F3 @ 0.5b for 0.5b vel 0.82  E3 @ 1b for 0.5b vel 0.78  A3 @ 1.5b for 2.5b vel 0.88 }
  # the 3-note HEAD, for fragmentation / sequence in development
  motif mythos_head  { D3 @ 0b for 0.5b vel 0.80  F3 @ 0.5b for 0.5b vel 0.82  E3 @ 1b for 0.5b vel 0.84 }
  # the BRIGHT cell: F lifted to F# — the same four notes, resolved (finale + coda)
  motif mythos_bright{ D3 @ 0b for 0.5b vel 0.78  F#3 @ 0.5b for 0.5b vel 0.82  E3 @ 1b for 0.5b vel 0.78  A3 @ 1.5b for 2.5b vel 0.86 }

  # FABLE — DERIVED from MYTHOS: M3 + step + P4 (the lifted contour), then a fall.
  motif fable        { F4 @ 0b for 0.75b vel 0.70  A4 @ 0.75b for 0.75b vel 0.74  G4 @ 1.5b for 0.5b vel 0.78  C5 @ 2b for 2b vel 0.84  Bb4 @ 4b for 1b vel 0.74  A4 @ 5b for 1b vel 0.72  F4 @ 6b for 2b vel 0.70 }

  # OPUS — MYTHOS inverted: the descent is the lineage turned inward, landing on D.
  motif opus         { D5 @ 0b for 1b vel 0.60  B4 @ 1b for 1b vel 0.58  C5 @ 2b for 1b vel 0.56  G4 @ 3b for 1.5b vel 0.54  D4 @ 4.5b for 1.5b vel 0.50 }

  # The RHYTHM as a motif — timpani "destiny" tag (D D D -> the dominant A)
  motif fate         { D2 @ 0b for 0.5b vel 0.72  D2 @ 0.5b for 0.5b vel 0.66  D2 @ 1b for 0.5b vel 0.74  A2 @ 1.5b for 1.5b vel 0.82 }
  motif fate_bright  { D2 @ 0b for 0.5b vel 0.72  D2 @ 0.5b for 0.5b vel 0.70  D2 @ 1b for 0.5b vel 0.76  D2 @ 1.5b for 1.5b vel 0.84 }

  # ===========================================================================
  # HARMONY — chromatic, with diminished pivots, mixture, and dominant pressure
  # ===========================================================================
  # I (D minor, cannot cadence — deceptive)
  motif prog_I1   { D3min @ 0b for 2b  A27 @ 2b for 2b  D3min @ 4b for 2b  F#2dim @ 6b for 2b }
  motif prog_I2   { G3min @ 0b for 2b  Eb3maj @ 2b for 2b  A27sus4 @ 4b for 2b  A27 @ 6b for 2b }
  # DEV (sequence through unstable harmony)
  motif prog_dev1 { D3min @ 0b for 1b  C#2dim7 @ 1b for 1b  Bb2maj @ 2b for 1b  A27 @ 3b for 1b }
  motif prog_dev2 { G#2dim7 @ 0b for 1b  A27 @ 1b for 1b  Bb2maj @ 2b for 1b  E2dim7 @ 3b for 1b }
  # II (taming attempt; mixture; the dominant withdrawn)
  motif prog_II1  { G3min @ 0b for 2b  Eb3maj @ 2b for 2b  C#2dim7 @ 4b for 2b  D3min @ 6b for 2b }
  motif prog_II2  { Bb2min @ 0b for 2b  Gb2maj @ 2b for 2b  E2dim @ 4b for 2b  A27sus4 @ 6b for 2b }
  # III (F major, A pedal lurking, deceptive)
  motif prog_III1 { F3maj7 @ 0b for 2b  A27 @ 2b for 2b  D3min7 @ 4b for 2b  Bb2maj7 @ 6b for 2b }
  motif prog_III2 { G3min7 @ 0b for 2b  C37 @ 2b for 2b  F3maj7 @ 4b for 2b  A27 @ 6b for 2b }
  # IV (the prepared dominant resolves; D major earned, with a bVI glow)
  motif prog_IVprep { A27sus4 @ 0b for 2b  A27 @ 2b for 4b }
  motif prog_IV1  { D3maj @ 0b for 2b  G3maj @ 2b for 2b  A27 @ 4b for 2b  D3maj @ 6b for 2b }
  motif prog_IV2  { D3maj @ 0b for 2b  Bb2maj @ 2b for 2b  G3maj @ 4b for 2b  A27 @ 6b for 2b }
  motif prog_coda { D3maj @ 0b for 4b  G3maj @ 4b for 2b  D3maj @ 6b for 2b }

  # Bass roots (with the dominant A as recurring pressure)
  motif roots_I   { D2 @ 0b for 2b  A1 @ 2b for 2b  D2 @ 4b for 2b  Bb1 @ 6b for 2b }
  motif roots_dev { D2 @ 0b for 1b  C#2 @ 1b for 1b  Bb1 @ 2b for 1b  A1 @ 3b for 1b }
  motif roots_II  { G2 @ 0b for 2b  Eb2 @ 2b for 2b  A1 @ 4b for 2b  D2 @ 6b for 2b }
  motif roots_III { F2 @ 0b for 2b  A1 @ 2b for 2b  D2 @ 4b for 2b  Bb1 @ 6b for 2b }
  motif roots_IV  { D2 @ 0b for 2b  G2 @ 2b for 2b  A1 @ 4b for 2b  D2 @ 6b for 2b }

