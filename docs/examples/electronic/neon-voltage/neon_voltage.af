# Neon Voltage — a 4:00 festival main-stage cue (electronic / big-room house).
# 128 BPM · F minor · 128 bars = exactly 240 s (1 bar = 1.875 s).
# Generated by Claude Fable 5.1 via Claude Code — 2026-09-05.
#
# Form (bar → seconds):
#   intro     bar   0 →   0 s   filtered kick, pad, arpeggio, master lowpass opening
#   groove    bar  16 →  30 s   full kick, rolling bass, claps, plucks
#   build 1   bar  32 →  60 s   riser + noise lift + snare roll, kick drops out at bar 46
#   drop 1    bar  48 →  90 s   supersaw hook + chord stabs + full drums
#   breakdown bar  64 → 120 s   drums out; the hook at half speed on a pluck, pad opens
#   build 2   bar  80 → 150 s   kick returns, riser, snare roll
#   drop 2    bar  88 → 165 s   hook doubled an octave down + acid line (ladder filter)
#   outro     bar 112 → 210 s   lead and stabs leave; filter closes; fade
#
# Harmony: i – VI – III – VII in F minor (Fm – Db – Ab – Eb), two bars per chord,
# one 8-bar (32-beat) cycle. Every loop below is 32 beats or a divisor of it.
# Section-scoped layers use `start:` on a bar boundary so their local beat 0 lands on the grid.

asset neon_voltage {
  kind: soundtrack
  duration: 240s
  tempo: 128bpm
  key: F minor
  emotion: urgency=0.5, triumph=0.7, cinematic_intensity=0.55
  # dramatic temperature: soft intro, two peaks, gentle exit
  intensity: 0s=0.6, 30s=0.78, 60s=0.82, 89s=0.85, 90s=1.0, 120s=0.72, 150s=0.8, 164s=0.85, 165s=1.0, 210s=0.9, 240s=0.6

  marker intro     @ 0s
  marker groove    @ 30s
  marker build_1   @ 60s
  marker drop_1    @ 90s
  marker breakdown @ 120s
  marker build_2   @ 150s
  marker drop_2    @ 165s
  marker outro     @ 210s

  # ---- the hook: 8 bars, dotted-eighth push, rising a third per chord ----
  motif hook {
    F3  @ 0b     for 0.75b vel 0.8
    Ab3 @ 0.75b  for 0.75b vel 0.8
    C4  @ 1.5b   for 0.5b  vel 0.82
    F4  @ 2b     for 1b    vel 0.95
    Eb4 @ 3b     for 0.5b  vel 0.8
    C4  @ 3.5b   for 0.5b  vel 0.78
    Ab3 @ 4b     for 0.75b vel 0.8
    C4  @ 4.75b  for 0.75b vel 0.8
    F4  @ 5.5b   for 0.5b  vel 0.85
    Eb4 @ 6b     for 1.5b  vel 0.9
    Db4 @ 8b     for 0.75b vel 0.8
    F4  @ 8.75b  for 0.75b vel 0.82
    Ab4 @ 9.5b   for 0.5b  vel 0.85
    F4  @ 10b    for 1b    vel 0.95
    Eb4 @ 11b    for 0.5b  vel 0.8
    Db4 @ 11.5b  for 0.5b  vel 0.78
    C4  @ 12b    for 0.75b vel 0.8
    Db4 @ 12.75b for 0.75b vel 0.8
    F4  @ 13.5b  for 0.5b  vel 0.85
    Ab4 @ 14b    for 1.5b  vel 0.92
    Ab3 @ 16b    for 0.75b vel 0.8
    C4  @ 16.75b for 0.75b vel 0.8
    Eb4 @ 17.5b  for 0.5b  vel 0.82
    Ab4 @ 18b    for 1b    vel 0.95
    G4  @ 19b    for 0.5b  vel 0.8
    Eb4 @ 19.5b  for 0.5b  vel 0.78
    C4  @ 20b    for 0.75b vel 0.8
    Eb4 @ 20.75b for 0.75b vel 0.8
    Ab4 @ 21.5b  for 0.5b  vel 0.85
    G4  @ 22b    for 1.5b  vel 0.9
    G3  @ 24b    for 0.75b vel 0.8
    Bb3 @ 24.75b for 0.75b vel 0.8
    Eb4 @ 25.5b  for 0.5b  vel 0.82
    G4  @ 26b    for 1b    vel 0.95
    F4  @ 27b    for 0.5b  vel 0.8
    Eb4 @ 27.5b  for 0.5b  vel 0.78
    Bb3 @ 28b    for 0.75b vel 0.8
    Eb4 @ 28.75b for 0.75b vel 0.8
    G4  @ 29.5b  for 0.5b  vel 0.85
    F4  @ 30b    for 1b    vel 0.9
    Eb4 @ 31b    for 1b    vel 0.85
  }

  # ---- rolling off-beat bass, one chord (2 bars); transposed per chord ----
  motif roll {
    F1 @ 0.5b for 0.4b vel 0.9
    F1 @ 1.5b for 0.4b vel 0.85
    F1 @ 2.5b for 0.4b vel 0.9
    F1 @ 3.5b for 0.4b vel 0.85
    F1 @ 4.5b for 0.4b vel 0.9
    F1 @ 5.5b for 0.4b vel 0.85
    F1 @ 6.5b for 0.4b vel 0.9
    F1 @ 7.5b for 0.4b vel 0.85
  }

  # ---- chord stabs, one chord (2 bars): 3-3-3-3-2-2 sixteenth grouping ----
  # written as single notes so `diatonic` shifts re-spell the quality within the key
  motif jab {
    F3  @ 0b for 0.3b vel 1.0
    Ab3 @ 0b for 0.3b vel 1.0
    C4  @ 0b for 0.3b vel 1.0
    F3  @ 0.75b for 0.3b vel 0.85
    Ab3 @ 0.75b for 0.3b vel 0.85
    C4  @ 0.75b for 0.3b vel 0.85
    F3  @ 1.5b for 0.3b vel 0.9
    Ab3 @ 1.5b for 0.3b vel 0.9
    C4  @ 1.5b for 0.3b vel 0.9
    F3  @ 2.25b for 0.3b vel 0.85
    Ab3 @ 2.25b for 0.3b vel 0.85
    C4  @ 2.25b for 0.3b vel 0.85
    F3  @ 3b for 0.3b vel 0.9
    Ab3 @ 3b for 0.3b vel 0.9
    C4  @ 3b for 0.3b vel 0.9
    F3  @ 3.5b for 0.3b vel 0.8
    Ab3 @ 3.5b for 0.3b vel 0.8
    C4  @ 3.5b for 0.3b vel 0.8
    F3  @ 4b for 0.3b vel 1.0
    Ab3 @ 4b for 0.3b vel 1.0
    C4  @ 4b for 0.3b vel 1.0
    F3  @ 4.75b for 0.3b vel 0.85
    Ab3 @ 4.75b for 0.3b vel 0.85
    C4  @ 4.75b for 0.3b vel 0.85
    F3  @ 5.5b for 0.3b vel 0.9
    Ab3 @ 5.5b for 0.3b vel 0.9
    C4  @ 5.5b for 0.3b vel 0.9
    F3  @ 6.25b for 0.3b vel 0.85
    Ab3 @ 6.25b for 0.3b vel 0.85
    C4  @ 6.25b for 0.3b vel 0.85
    F3  @ 7b for 0.3b vel 0.9
    Ab3 @ 7b for 0.3b vel 0.9
    C4  @ 7b for 0.3b vel 0.9
    F3  @ 7.5b for 0.3b vel 0.8
    Ab3 @ 7.5b for 0.3b vel 0.8
    C4  @ 7.5b for 0.3b vel 0.8
  }

  # ---- buses ----------------------------------------------------------------
  # the pump: everything tonal that should breathe with the kick
  bus pump {
    duck: source=kick amount=8db attack=0.005s release=0.14s threshold=-40db
    fx: saturate(amount=0.1, warmth=0.2)
  }
  # air: eighth-note delay (60/128/2 = 0.234 s) + a shared hall for leads
  bus air {
    fx: delay(time=0.234, feedback=0.3, mix=0.18), hall(rt60=2.0, damp=0.45, mix=0.14)
  }

  # ---- drums ----------------------------------------------------------------
  layer kick : drums {
    voice: kick
    pattern: X...X...X...X...
    tune: -4st
    decay: 0.7
    snap: 0.6
    bend: 0.5
    gain: -2db
    humanize: 0.03
    auto gain: 0s=-16db, 15s=-9db, 29.9s=-5db, 30s=0db, 86.2s=0db, 86.3s=-60db, 89.9s=-60db, 90s=0db, 119.9s=0db, 120s=-60db, 149.9s=-60db, 150s=-4db, 164.9s=-1db, 165s=0db, 224s=0db, 236s=-4db, 240s=-12db
  }

  layer clap : drums {
    voice: clap
    pattern: ....X.......X...
    gain: 0db
    humanize: 0.05
    fx: reverb(decay=0.9s, mix=0.16)
    auto gain: 0s=-60db, 29.9s=-60db, 30s=2db, 89.9s=2db, 90s=4db, 119.9s=4db, 120s=-60db, 164.9s=-60db, 165s=4db, 209.9s=4db, 210s=1db, 232s=0db, 240s=-20db
  }

  # a snare under the clap only in the drops
  layer snare : drums {
    voice: snare
    pattern: ....X.......X...
    tune: -2st
    gain: -11db
    humanize: 0.04
    fx: reverb(decay=1.2s, mix=0.2)
    auto gain: 0s=-60db, 89.9s=-60db, 90s=0db, 119.9s=0db, 120s=-60db, 164.9s=-60db, 165s=1db, 209.9s=1db, 210s=-60db
  }

  layer chats : drums {
    voice: hat
    pattern: ..x...x...x...x.
    tune: 2st
    decay: 0.3
    gain: -14db
    pan: 0.22
    humanize: 0.06
    auto gain: 0s=-60db, 14.9s=-60db, 15s=-7db, 29.9s=-4db, 30s=-1db, 89.9s=-1db, 90s=0db, 119.9s=0db, 120s=-60db, 149.9s=-60db, 150s=-3db, 164.9s=-1db, 165s=0db, 209.9s=0db, 210s=-1db, 236s=-3db, 240s=-30db
  }

  # sixteenth hats with off-beat accents, drops only
  layer hat16 : drums {
    voice: hat
    pattern: xxXxxxXxxxXxxxXx
    tune: 4st
    decay: 0.25
    gain: -20db
    pan: -0.28
    humanize: 0.08
    auto gain: 0s=-60db, 89.9s=-60db, 90s=0db, 119.9s=0db, 120s=-60db, 164.9s=-60db, 165s=1db, 209.9s=1db, 210s=-60db
  }

  layer ohat : drums {
    voice: open_hat
    pattern: ..x...x...x...x.
    decay: 0.5
    gain: -16db
    pan: -0.15
    auto gain: 0s=-60db, 29.9s=-60db, 30s=-2db, 89.9s=-2db, 90s=0db, 119.9s=0db, 120s=-60db, 164.9s=-60db, 165s=0db, 209.9s=0db, 210s=-3db, 236s=-5db, 240s=-30db
  }

  # snare rolls: 8 bars each, quarters -> eighths -> sixteenths -> accented sixteenths
  layer roll_1 : drums {
    voice: snare
    pattern: x...x...x...x...x...x...x...x...x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    start: 75s
    duration: 15s
    gain: 0db
    fx: highpass(300hz), reverb(decay=1.0s, mix=0.18)
    auto gain: 0s=-20db, 7.5s=-13db, 15s=-6db
  }
  layer roll_2 : drums {
    voice: snare
    pattern: x...x...x...x...x...x...x...x...x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    start: 150s
    duration: 15s
    gain: 0db
    fx: highpass(300hz), reverb(decay=1.0s, mix=0.18)
    auto gain: 0s=-20db, 7.5s=-12db, 15s=-5db
  }

  # ---- low end ----------------------------------------------------------------
  # sustained sub, one note per chord (F1 / Db2 / Ab1 / Eb2)
  layer sub : notes {
    osc: sine
    bus: pump
    gain: 0db
    env: a=0.01s d=0.1s s=0.9 r=0.08s
    notes: F1 @ 0b for 7.9b, Db2 @ 8b for 7.9b, Ab1 @ 16b for 7.9b, Eb2 @ 24b for 7.9b
    loop: 32b
    fx: lowpass(120hz)
    auto gain: 0s=-60db, 29.9s=-60db, 30s=-11db, 89.9s=-11db, 90s=-9db, 119.9s=-9db, 120s=-16db, 149.9s=-16db, 150s=-13db, 164.9s=-11db, 165s=-9db, 209.9s=-9db, 210s=-12db, 236s=-15db, 240s=-30db
  }

  # rolling saw bass on the off-beat eighths, sidechained
  layer bass : notes {
    osc: saw
    bus: pump
    gain: 0db
    env: a=0.004s d=0.1s s=0.4 r=0.06s
    velbright: 0.5
    play roll @ 0b
    play roll @ 8b  transpose +8st
    play roll @ 16b transpose +3st
    play roll @ 24b transpose +10st
    loop: 32b
    fx: lowpass(600hz), drive(amount=0.3)
    auto cutoff: 0s=400, 30s=500, 60s=900, 89.9s=1200, 90s=1400, 120s=400, 150s=700, 165s=1600, 210s=900, 240s=300
    auto gain: 0s=-60db, 29.9s=-60db, 30s=-14db, 89.9s=-13db, 90s=-11db, 119.9s=-11db, 120s=-60db, 149.9s=-60db, 150s=-18db, 164.9s=-14db, 165s=-11db, 209.9s=-11db, 210s=-14db, 236s=-16db, 240s=-30db
  }

  # ---- harmony ----------------------------------------------------------------
  # the pad is a detuned left/right pair so the intro and breakdown have real width
  layer pad_l : notes {
    osc: pad
    bus: pump
    bandwidth: 50c
    gain: -3db
    detune: -5c
    pan: -0.6
    env: a=1.2s d=1.0s s=0.85 r=2.5s
    notes: F2min @ 0b for 8b voicing spread, Db2maj @ 8b for 8b voicing spread, Ab2maj @ 16b for 8b voicing spread, Eb2maj @ 24b for 8b voicing spread
    loop: 32b
    fx: lowpass(1800hz), reverb(decay=3.5s, mix=0.3)
    auto cutoff: 0s=500, 30s=1400, 90s=2600, 120s=3200, 165s=2600, 210s=2000, 240s=600
    auto gain: 0s=-18db, 29.9s=-18db, 30s=-24db, 59.9s=-24db, 60s=-22db, 89.9s=-22db, 90s=-21db, 119.9s=-21db, 120s=-16db, 149.9s=-16db, 150s=-19db, 164.9s=-19db, 165s=-21db, 209.9s=-21db, 210s=-20db, 240s=-24db
  }
  layer pad_r : notes {
    osc: pad
    bus: pump
    bandwidth: 50c
    gain: -3db
    detune: 5c
    pan: 0.6
    env: a=1.2s d=1.0s s=0.85 r=2.5s
    notes: F2min @ 0b for 8b voicing spread, Db2maj @ 8b for 8b voicing spread, Ab2maj @ 16b for 8b voicing spread, Eb2maj @ 24b for 8b voicing spread
    loop: 32b
    fx: lowpass(1800hz), reverb(decay=3.5s, mix=0.3)
    auto cutoff: 0s=500, 30s=1400, 90s=2600, 120s=3200, 165s=2600, 210s=2000, 240s=600
    auto gain: 0s=-18db, 29.9s=-18db, 30s=-24db, 59.9s=-24db, 60s=-22db, 89.9s=-22db, 90s=-21db, 119.9s=-21db, 120s=-16db, 149.9s=-16db, 150s=-19db, 164.9s=-19db, 165s=-21db, 209.9s=-21db, 210s=-20db, 240s=-24db
  }

  # sixteenth-note arpeggio, two octaves, the constant motion under everything
  layer arp : notes {
    osc: square
    bus: pump
    gain: 0db
    pan: 0.32
    env: a=0.003s d=0.12s s=0.15 r=0.1s
    velbright: 0.6
    arp: up rate=0.25b octaves=2 gate=0.7
    notes: F3min @ 0b for 8b, Db3maj @ 8b for 8b, Ab3maj @ 16b for 8b, Eb3maj @ 24b for 8b
    loop: 32b
    fx: lowpass(2600hz), delay(time=0.351, feedback=0.25, mix=0.2)
    auto cutoff: 0s=900, 30s=2200, 60s=3000, 90s=2400, 120s=3400, 165s=2600, 210s=2600, 240s=800
    auto gain: 0s=-60db, 7.4s=-60db, 7.5s=-24db, 29.9s=-21db, 30s=-22db, 59.9s=-22db, 60s=-20db, 89.9s=-19db, 90s=-27db, 119.9s=-27db, 120s=-20db, 149.9s=-20db, 150s=-19db, 164.9s=-19db, 165s=-26db, 209.9s=-26db, 210s=-21db, 236s=-23db, 240s=-40db
  }

  # off-beat pluck chords for the groove section and the outro
  layer pluck : notes {
    osc: pluck
    bus: pump
    damping: 0.5
    brightness: 0.7
    gain: 0db
    pan: -0.3
    env: a=0.002s d=0.2s s=0.3 r=0.15s
    notes: F3min @ 0.5b for 0.4b, F3min @ 1.5b for 0.4b, F3min @ 2.5b for 0.4b, F3min @ 3.5b for 0.4b vel 0.9,
           F3min @ 4.5b for 0.4b, F3min @ 5.5b for 0.4b, F3min @ 6.5b for 0.4b, F3min @ 7.5b for 0.4b vel 0.9,
           Db3maj @ 8.5b for 0.4b, Db3maj @ 9.5b for 0.4b, Db3maj @ 10.5b for 0.4b, Db3maj @ 11.5b for 0.4b vel 0.9,
           Db3maj @ 12.5b for 0.4b, Db3maj @ 13.5b for 0.4b, Db3maj @ 14.5b for 0.4b, Db3maj @ 15.5b for 0.4b vel 0.9,
           Ab3maj @ 16.5b for 0.4b, Ab3maj @ 17.5b for 0.4b, Ab3maj @ 18.5b for 0.4b, Ab3maj @ 19.5b for 0.4b vel 0.9,
           Ab3maj @ 20.5b for 0.4b, Ab3maj @ 21.5b for 0.4b, Ab3maj @ 22.5b for 0.4b, Ab3maj @ 23.5b for 0.4b vel 0.9,
           Eb3maj @ 24.5b for 0.4b, Eb3maj @ 25.5b for 0.4b, Eb3maj @ 26.5b for 0.4b, Eb3maj @ 27.5b for 0.4b vel 0.9,
           Eb3maj @ 28.5b for 0.4b, Eb3maj @ 29.5b for 0.4b, Eb3maj @ 30.5b for 0.4b, Eb3maj @ 31.5b for 0.4b vel 0.9
    loop: 32b
    fx: delay(time=0.234, feedback=0.22, mix=0.18), reverb(decay=1.4s, mix=0.2)
    auto gain: 0s=-60db, 29.9s=-60db, 30s=-20db, 89.9s=-19db, 90s=-60db, 209.9s=-60db, 210s=-20db, 236s=-22db, 240s=-40db
  }

  # ---- drop 1 + drop 2: stabs (a detuned pair, hard-panned for width) ----------
  # runs 90 s → 210 s (64 bars); local seconds: drop 1 = 0–30, breakdown = 30–75, drop 2 = 75–120
  layer stabs_l : notes {
    osc: saw
    unison: 5
    spread: 20c
    detune: -6c
    bus: pump
    gain: 0db
    pan: -0.55
    start: 90s
    duration: 120s
    env: a=0.003s d=0.14s s=0.0 r=0.12s
    velbright: 0.6
    play jab @ 0b
    play jab @ 8b  diatonic -2
    play jab @ 16b diatonic 2
    play jab @ 24b diatonic -1
    loop: 32b
    fx: highpass(180hz), lowpass(4200hz)
    auto gain: 0s=-12db, 29.9s=-12db, 30s=-60db, 74.9s=-60db, 75s=-11db, 120s=-11db
  }
  layer stabs_r : notes {
    osc: saw
    unison: 5
    spread: 20c
    detune: 6c
    bus: pump
    gain: 0db
    pan: 0.55
    start: 90s
    duration: 120s
    env: a=0.003s d=0.14s s=0.0 r=0.12s
    velbright: 0.6
    play jab @ 0b
    play jab @ 8b  diatonic -2
    play jab @ 16b diatonic 2
    play jab @ 24b diatonic -1
    loop: 32b
    fx: highpass(180hz), lowpass(4200hz)
    auto gain: 0s=-12db, 29.9s=-12db, 30s=-60db, 74.9s=-60db, 75s=-11db, 120s=-11db
  }

  # ---- the lead hook (detuned pair) — drop 1 (local 0–64 b) and drop 2 (local 160–256 b)
  layer lead_l : notes {
    osc: saw
    unison: 6
    spread: 24c
    detune: -7c
    bus: air
    gain: -12db
    pan: -0.4
    start: 90s
    duration: 121s
    env: a=0.01s d=0.15s s=0.7 r=0.25s
    velbright: 0.5
    play hook @ 0b
    play hook @ 32b vel 1.05
    play hook @ 160b
    play hook @ 192b vel 1.05
    play hook @ 224b vel 1.1
    fx: lowpass(3600hz)
    auto cutoff: 0s=2400, 14s=4200, 30s=4200, 75s=2600, 90s=4800, 120s=4800
  }
  layer lead_r : notes {
    osc: saw
    unison: 6
    spread: 24c
    detune: 7c
    bus: air
    gain: -12db
    pan: 0.4
    start: 90s
    duration: 121s
    env: a=0.01s d=0.15s s=0.7 r=0.25s
    velbright: 0.5
    play hook @ 0b
    play hook @ 32b vel 1.05
    play hook @ 160b
    play hook @ 192b vel 1.05
    play hook @ 224b vel 1.1
    fx: lowpass(3600hz)
    auto cutoff: 0s=2400, 14s=4200, 30s=4200, 75s=2600, 90s=4800, 120s=4800
  }

  # drop 2 only: the hook an octave down, centred, for weight
  layer lead_low : notes {
    osc: saw
    unison: 3
    spread: 12c
    bus: pump
    gain: -16db
    start: 165s
    duration: 46s
    env: a=0.01s d=0.15s s=0.7 r=0.25s
    play hook @ 0b  transpose -12st
    play hook @ 32b transpose -12st
    play hook @ 64b transpose -12st vel 1.05
    fx: lowpass(1400hz)
  }

  # ---- breakdown: the hook at half speed on a plucked string, wide and wet ----
  layer reflection : notes {
    osc: pluck
    damping: 0.35
    brightness: 0.75
    bus: air
    gain: -3db
    pan: 0.1
    start: 120s
    duration: 31s
    env: a=0.002s d=0.5s s=0.5 r=0.8s
    play hook @ 0b stretch 2 transpose +12st vel 0.8
    fx: reverb(decay=3.5s, mix=0.38)
  }

  # drop 2, second half: an acid line through the transistor-ladder filter
  layer acid : notes {
    osc: saw
    gain: 0db
    pan: -0.12
    start: 180s
    duration: 30s
    env: a=0.003s d=0.08s s=0.25 r=0.04s
    notes: F2 @ 0b for 0.22b, F2 @ 0.5b for 0.22b vel 0.9, F3 @ 1b for 0.22b, Ab2 @ 1.5b for 0.22b, F2 @ 2b for 0.22b, C3 @ 2.5b for 0.22b, F2 @ 3b for 0.22b vel 1.0, Eb2 @ 3.5b for 0.22b
    loop: 4b
    fx: ladder(cutoff=400, resonance=0.8, drive=0.45)
    auto cutoff: 0s=320, 12s=2600, 15s=700, 27s=3400, 30s=900
    auto gain: 0s=-20db, 4s=-12db, 26s=-11db, 29s=-11db, 30s=-40db
  }

  # ---- transitions ---------------------------------------------------------------
  layer riser_1 : sweep {
    shape: saw
    from: 90hz
    to: 5200hz
    curve: exp
    start: 75s
    duration: 15s
    gain: -18db
    env: a=13.5s d=0.5s s=1.0 r=0.3s
    fx: highpass(200hz), reverb(decay=1.5s, mix=0.2)
  }
  layer riser_2 : sweep {
    shape: saw
    from: 90hz
    to: 6000hz
    curve: exp
    start: 150s
    duration: 15s
    gain: -17db
    env: a=13.5s d=0.5s s=1.0 r=0.3s
    fx: highpass(200hz), reverb(decay=1.5s, mix=0.2)
  }
  layer lift_1 : noise {
    color: white
    start: 78.75s
    duration: 11.25s
    gain: -14db
    env: a=10.5s d=0.3s s=1.0 r=0.2s
    fx: highpass(400hz), lowpass(9000hz)
    auto cutoff: 0s=400, 11.25s=3000
  }
  layer lift_2 : noise {
    color: white
    start: 153.75s
    duration: 11.25s
    gain: -13db
    env: a=10.5s d=0.3s s=1.0 r=0.2s
    fx: highpass(400hz), lowpass(9000hz)
    auto cutoff: 0s=400, 11.25s=3000
  }
  # crash washes on each drop
  layer crash_1 : noise {
    color: white
    start: 90s
    duration: 3s
    gain: -4db
    env: a=0.003s d=1.6s s=0.0 r=0.5s
    fx: highpass(2500hz), reverb(decay=2s, mix=0.3)
  }
  layer crash_2 : noise {
    color: white
    start: 165s
    duration: 3s
    gain: -3db
    env: a=0.003s d=1.8s s=0.0 r=0.5s
    fx: highpass(2500hz), reverb(decay=2s, mix=0.3)
  }
  # downlifter into the breakdown
  layer fall : sweep {
    shape: saw
    from: 2600hz
    to: 45hz
    curve: exp
    start: 120s
    duration: 3s
    gain: -14db
    env: a=0.01s d=2.2s s=0.2 r=0.5s
    fx: lowpass(3000hz), reverb(decay=2.5s, mix=0.35)
  }

  master {
    width: 0.95
    lufs: -8.5
    peak: -0.8db
    fadein: 0.3s
    fadeout: 4s
    fx: lowpass(20000hz), highpass(25hz), fdn(rt60=1.2, rt60_high=0.7, mix=0.05), comp(threshold=-12, ratio=2.0, attack=0.01, release=0.11, knee=6), saturate(amount=0.1, warmth=0.2)
    auto cutoff: 0s=550, 8s=800, 18s=1800, 27s=8000, 30s=20000, 224s=20000, 236s=3000, 240s=900
  }
}
