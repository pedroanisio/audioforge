# house_04_phase — "Phase & flange". The modulation family on arpeggios: phaser on the
# pad, flanger on the hats, chorus on the keys, a bit-crushed breakdown, a synth
# lead through the tape kernel, everything pumping under the kick.
asset house_04_phase { kind: soundtrack
  duration: 62s
  tempo: 124bpm
  key: D minor, 64b=F major
  meter: 4 4
  groove: swing16 0.15
  form: intro 0b for 16b, arps 16b for 48b, breakdown 64b for 32b, outro 96b for 32b
  bus drums {
    fx: comp(threshold=-12, ratio=3, attack=0.004, release=0.08)
  }
  bus arps {
    gain: -2db
    duck: source=kick amount=6db attack=0.008s release=0.2s threshold=-40db
    fx: lowpass(5000hz, q=1.0), saturate(amount=0.1)
    auto cutoff: 0s=1200, 16s=5000, 62s=6000
  }
  bus crush {
    gain: -4db
    duck: source=kick amount=5db attack=0.01s release=0.2s threshold=-40db
    fx: bitcrush(bits=5, downsample=4, mix=0.85), lowpass(3000hz, q=1.4), plate(decay=0.5, mix=0.15)
  }
  layer kick : drums { voice: kick
    bus: drums
    gain: -3db
    decay: 0.5
    snap: 0.65
    pattern: x...x...x...x... }
  layer clap : drums { voice: clap
    bus: drums
    gain: -13db
    pattern: ....x.......x... }
  layer hats : drums { voice: hat
    bus: drums
    gain: -17db
    decay: 0.3
    pattern: x.x.x.x.x.x.x.x.
    fx: flanger(rate=0.18, depth=2.5, delay=1.5, feedback=0.55, mix=0.5) }
  layer bass : notes { osc: saw
    bus: arps
    gain: -8db
    notes: D1min @ 0b for 64b voicing close, F1maj @ 64b for 64b voicing close
    arp: updown rate=0.25b octaves=2 gate=0.6
    env: a=0.003s d=0.12s s=0.3 r=0.05s
    fx: lowpass(900hz, q=1.6), drive(amount=0.2) }
  layer arp_keys : notes { osc: square
    bus: arps
    gain: -14db
    notes: D3min7 @ 0b for 16b voicing drop2, Bb2maj7 @ 16b for 16b voicing drop2, G2min7 @ 32b for 16b voicing drop2, A2min7 @ 48b for 16b voicing drop2,
           F3maj7 @ 64b for 16b voicing drop2, D3min7 @ 80b for 16b voicing drop2, Bb2maj7 @ 96b for 16b voicing drop2, C3maj7 @ 112b for 16b voicing drop2
    arp: up rate=0.25b octaves=1 gate=0.5
    env: a=0.002s d=0.1s s=0.2 r=0.05s
    fx: chorus(rate=0.7, depth=6, delay=20, voices=4, mix=0.45), highpass(200hz) }
  layer pad : notes { osc: pad
    bus: arps
    gain: -19db
    notes: D3min7 @ 0b for 32b voicing spread, G2min7 @ 32b for 32b voicing spread, F3maj7 @ 64b for 32b voicing spread, Bb2maj7 @ 96b for 32b voicing spread
    env: a=1s d=0.5s s=0.9 r=1.5s
    fx: phaser(rate=0.22, depth=0.85, stages=6, feedback=0.45, center=700hz, spread=2.2, mix=0.55) }
  layer lead : notes { osc: saw
    bus: arps
    gain: -13db
    notes: A4 @ 64b for 1.5b, F4 @ 65.5b for 0.5b, G4 @ 66b for 1b, C5 @ 67b for 1b, A4 @ 68b for 2b, F4 @ 70b for 1b, E4 @ 71b for 1b,
           A4 @ 72b for 1.5b, F4 @ 73.5b for 0.5b, G4 @ 74b for 1b, C5 @ 75b for 1b, D5 @ 76b for 2b, C5 @ 78b for 1b, A4 @ 79b for 1b,
           A4 @ 80b for 1.5b, F4 @ 81.5b for 0.5b, G4 @ 82b for 1b, C5 @ 83b for 1b, A4 @ 84b for 2b, F4 @ 86b for 1b, E4 @ 87b for 1b,
           F4 @ 88b for 4b, E4 @ 92b for 4b
    unison: 3
    spread: 12c
    env: a=0.01s d=0.2s s=0.7 r=0.15s
    fx: tape(drive=0.5, flutter=0.35, tone=0.6, mix=0.8), delay(time=0.3629, feedback=0.3, mix=0.25) }
  layer crushed : notes { osc: pluck
    bus: crush
    gain: -12db
    notes: F3maj7 @ 64b for 8b voicing drop2, C3maj7 @ 72b for 8b voicing drop2, D3min7 @ 80b for 8b voicing drop2, Bb2maj7 @ 88b for 8b voicing drop2
    arp: downup rate=0.125b octaves=2 gate=0.7
    env: a=0.002s d=0.15s s=0.2 r=0.05s }
  master { peak: -1db
    lufs: -9
    fx: mbcomp(threshold=-16, ratio=2.5, low=160, high=3000), saturate(amount=0.06) }
}
