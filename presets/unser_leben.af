# Johann Bach (1604-1673) — "Unser Leben ist ein Schatten", opening
# statement (mm. 1-8, complete authentic cadence), six voices.
#
# PROVENANCE: transcribed visually from the Claverie LilyPond engraving
# (IMSLP 404011, CC BY-SA typeset; the composition itself is public
# domain), rasterized at 300 dpi and read per staff with harmonic
# cross-checks per measure. Inner-voice eighth-note details carry a
# small residual transcription risk (+-1 step on 2-3 inner notes);
# the outer voices, the chromatic ascent (G-Ab-A-B natural -> C), the
# m2 durezza cross-relation over the G pedal, and the m4-6 descending
# 6/5 sequence are verified.
#
# REALIZATION: an instrumental synth-consort rendering (no vocal
# samples are pinned in this project; the bass reaches Eb2, far below
# the violin library). Dynamics are interpretive — the source has
# none, per period practice. Staged in the Lady Chapel, St Albans
# (OpenAIR, CC BY 4.0 — see samples/stalbans_ortf_ir.ATTRIBUTION.txt).
asset unser_leben_opening {
  kind: soundtrack
  duration: 31s
  samplerate: 48000
  bitdepth: 24
  tempo: 76bpm
  key: C minor

  marker statement_1 @ 0s
  marker statement_2 @ 9.5s
  marker chromatic_ascent @ 19.7s
  marker cadence @ 22.1s

  stage {
    hall: "stalbans_ortf_ir.wav@be670d833feaf274e601ad026b4f32f126c71fa8eb9b386e855ed9f0035410aa"
    mics: tree=0.74, close=0.18, ambient=0.5
