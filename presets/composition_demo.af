# v2.7 composition ergonomics in one cue: chord symbols with voicings, an
# arpeggiator, Euclidean rhythm, motif development by transforms (the theme
# answers itself inverted, retrograde, and diatonically shifted), a key
# modulation at the lift, an accelerando into it and a ritardando out.
asset composition_demo {
  kind: cue
  duration: 24s
  samplerate: 48000
  bitdepth: 24
  tempo: 92bpm, 20b=92bpm, 26b=116bpm, 34b=116bpm, 38b=84bpm
  key: A minor, 26b=C major
  groove: laidback 0.4

  marker theme @ 0s
  marker development @ 5.2s
  marker lift @ 14.7s
  marker settle @ 21s

  motif theme {
    A3 @ 0b for 1b vel 0.72
    C4 @ 1b for 0.5b vel 0.6
    E4 @ 1.5b for 1.5b vel 0.8
    D4 @ 3b for 1b vel 0.62
    A3 @ 4b for 2b vel 0.7
  }

  bus music {
    duck: source=pulse amount=3.5db attack=0.01s release=0.14s threshold=-36db
    fx: peak(450hz, gain=-2, q=1.1), hall(rt60=2.4s, damp=0.45, mix=0.24),
        saturate(amount=0.12, warmth=0.3)
  }

  layer harmony : notes {
    osc: pad
    gain: -15db
    bus: music
    env: a=0.5s d=0.8s s=0.8 r=1.5s
    notes: A2min7 @ 0b for 8b vel 0.55 voicing open,
           F2maj7 @ 8b for 6b vel 0.55 voicing spread,
           E2min7 @ 14b for 6b vel 0.5 voicing drop2,
           G2maj @ 20b for 6b vel 0.6 voicing open,
           C3maj9 @ 26b for 8b vel 0.7 voicing spread,
           F3maj7 @ 34b for 8b vel 0.55 voicing drop2
  }
  layer arpeggio : notes {
    osc: pluck
    damping: 0.45
    brightness: 0.7
    gain: -16db
    pan: 0.22
    bus: music
    humanize: 0.45
    velbright: 0.7
    arp: updown rate=0.25b octaves=2 gate=0.82
    env: a=0.003s d=0.25s s=0.15 r=0.4s
    notes: A3min7 @ 0b for 8b vel 0.6, F3maj7 @ 8b for 6b vel 0.6,
           E3min7 @ 14b for 6b vel 0.55, G3maj @ 20b for 6b vel 0.7,
           C4maj9 @ 26b for 8b vel 0.8, F4maj7 @ 34b for 8b vel 0.55
  }
  layer melody : notes {
    osc: morph
    scan: 0.35
    gain: -12db
    pan: -0.12
    bus: music
    humanize: 0.5
    velbright: 0.75
    glide: 0.04s
    vibrato: rate=5.3 depth=11c delay=0.28s
    env: a=0.04s d=0.4s s=0.6 r=0.6s
    play theme @ 0b
    play theme @ 8b invert vel 0.9
    play theme @ 14b retrograde diatonic -2 vel 0.85
    play theme @ 26b diatonic +2 vel 1.15
    play theme @ 34b stretch 1.5 vel 0.8
    auto scan: 0s=0.3, 15s=0.75, 24s=0.25
  }
  layer pulse : drums {
    voice: kick
    pattern: X...x...X...x...
    gain: -8db
    humanize: 0.3
  }
  layer texture : drums {
    voice: hat
    pattern: euclid(7,16,1)
    gain: -21db
    pan: 0.25
    humanize: 0.6
    fx: highpass(1800hz)
  }
  master {
    width: 0.78
    lufs: -16
    peak: -1db
    fadein: 0.4s
    fadeout: 2.5s
    fx: lowshelf(95hz, gain=1), highshelf(10000hz, gain=1.2),
        saturate(amount=0.1, warmth=0.25)
  }
}
