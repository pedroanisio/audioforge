# Branded sonic signature — the v1 identity, now authored in the DSL.
asset brand_signature_v2 {
  kind: signature
  duration: 2.8s
  tempo: 100bpm
  key: C major
  emotion: wonder=0.6, triumph=0.4

  marker logo_in @ 0s
  marker logo_lock @ 1.2s

  layer chime : notes {
    osc: fm
    fmratio: 2
    fmindex: 1.6
    gain: -4db
    env: a=0.005s d=0.9s s=0 r=0.3s
    notes: C4 @ 0b for 2.5b, G4 @ 0.5b for 2b, E5 @ 1b for 2b vel 0.8
    fx: reverb(decay=1.6s, mix=0.35)
  }
  layer shimmer : tone {
    osc: sine
    note: C6
    detune: 7c
    start: 0.6s
    duration: 2s
    gain: -14db
    pan: 0.3
    env: a=0.2s d=1.2s s=0 r=0.4s
    fx: tremolo(rate=6, depth=0.4), reverb(decay=2s, mix=0.5)
  }
  layer sub : tone {
    osc: sine
    note: C2
    duration: 1.8s
    gain: -8db
    env: a=0.01s d=1.4s s=0 r=0.3s
  }
  master {
    width: 0.7
    peak: -1db
    fadeout: 0.12s
    fx: highpass(35hz)
  }
}
