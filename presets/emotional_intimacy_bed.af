# Emotional background music — intimate, warm, slowly breathing.
asset intimate_bed_v1 {
  kind: bed
  duration: 24s
  tempo: 66bpm
  key: A major
  emotion: intimacy=0.8, calm=0.7, sadness=0.3
  intensity: 0s=0.4, 12s=0.7, 24s=0.3

  marker loop_in @ 0s
  marker swell @ 12s

  layer warm_pad : notes {
    osc: triangle
    detune: 8c
    gain: -9db
    loop: 16b
    env: a=1.8s d=1s s=0.8 r=2.5s
    notes: A2 @ 0b for 8b, E3 @ 0b for 8b, C#4 @ 0b for 8b,
           F#2 @ 8b for 8b, C#3 @ 8b for 8b, A3 @ 8b for 8b
    fx: lowpass(1600hz), reverb(decay=3.5s, mix=0.4)
  }
  layer felt_keys : notes {
    osc: sine
    gain: -12db
    pan: 0.2
    env: a=0.02s d=1.6s s=0 r=0.8s
    notes: E5 @ 2b for 2b vel 0.7, C#5 @ 6b for 2b vel 0.6,
           A4 @ 10b for 3b vel 0.8, B4 @ 14b for 2b vel 0.6,
           C#5 @ 18b for 4b vel 0.75
    fx: delay(time=0.45s, feedback=0.3, mix=0.3), reverb(decay=2.5s, mix=0.4)
  }
  layer air : noise {
    color: pink
    gain: -30db
    env: a=3s d=8s s=0.7 r=5s
    fx: lowpass(1200hz), tremolo(rate=0.12, depth=0.4)
  }
  master {
    width: 0.7
    lufs: -18
    fadein: 1s
    fadeout: 2s
  }
}
