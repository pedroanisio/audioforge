# v2.5 instrument classes, all five in one cue:
# bespoke modal percussion, morph lead riding a scan automation, granular
# shimmer, bowed bass, and a content-addressed sample groove.
asset new_voices_demo {
  kind: cue
  duration: 16s
  samplerate: 48000
  bitdepth: 24
  tempo: 92bpm
  key: C minor
  groove: laidback 0.5

  layer clay_pots : notes {
    osc: modal
    modes: 1.0 1.0 1.0, 1.83 0.55 0.5, 2.69 0.4 0.34, 4.12 0.28 0.2, 6.3 0.14 0.1
    modedecay: 0.9s
    gain: -15db
    pan: -0.25
    humanize: 0.55
    velbright: 0.6
    loop: 4b
    env: a=0.004s d=0.3s s=0.15 r=0.5s
    notes: C4 @ 0.5b for 0.5b vel 0.6, Eb4 @ 1.5b for 0.5b vel 0.45,
           G4 @ 2.5b for 0.5b vel 0.55, C4 @ 3.25b for 0.5b vel 0.4
    fx: plate(decay=0.55, damp=0.45, mix=0.2)
  }
  layer morph_lead : tone {
    osc: morph
    note: C3
    duration: 16s
    gain: -15db
    pan: 0.12
    env: a=0.8s d=1s s=0.85 r=2s
    auto scan: 0s=0.05, 8s=0.85, 13s=0.3, 16s=0.05
    fx: lowpass(5200hz), hall(rt60=2.6, damp=0.45, mix=0.24)
  }
  layer shimmer : grain {
    source: pad
    note: C5
    srcdur: 2s
    grainsize: 0.07s
    density: 55
    pitchspread: 35c
    scatter: 0.7
    duration: 16s
    gain: -21db
    pan: 0.3
    env: a=2s d=2s s=0.75 r=3s
    fx: highpass(800hz), fdn(rt60=5, rt60_high=2, crossover=2400hz, size=1.3, mix=0.35)
  }
  layer bowed_bass : notes {
    osc: bowed
    pressure: 0.58
    bowpos: 0.11
    brightness: 0.5
    gain: -14db
    pan: 0
    humanize: 0.3
    env: a=0.15s d=0.4s s=0.85 r=0.8s
    notes: C2 @ 0b for 7.5b, Ab1 @ 8b for 3.5b, G1 @ 12b for 4b
    fx: lowpass(1400hz)
  }
  layer knock_groove : sample {
    file: "deep_knock.wav"
    sha256: "d7e1dc7271508d6118aec993ff6a3dc4f0b53861f261e551af1eff0ce404b9c0"
    pattern: X..x..x.X...x..x
    gain: -10db
    pan: 0.05
    humanize: 0.45
    fx: comp(threshold=-18, ratio=2.5, attack=0.02, release=0.15, knee=5, makeup=1)
  }
  master {
    width: 0.8
    lufs: -16
    peak: -1db
    fadein: 0.5s
    fadeout: 2.5s
    fx: highpass(30hz), comp(threshold=-17, ratio=1.7, attack=0.03, release=0.2, knee=6, makeup=0.8)
  }
}
