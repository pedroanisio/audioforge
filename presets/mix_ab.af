# A/B: identical arrangement, flat mix vs full v2.6 production chain.
asset mix_flat {
  kind: cue
  duration: 12s
  tempo: 96bpm
  key: F minor
  groove: laidback 0.5

  motif line {
    F3 @ 0b for 1.5b vel 0.7
    Ab3 @ 2b for 1b vel 0.6
    C4 @ 3b for 1b vel 0.75
    Eb4 @ 4b for 2b vel 0.85
    C4 @ 6.5b for 1b vel 0.6
    F4 @ 8b for 3.5b vel 0.9
  }

  layer pad : tone {
    osc: pad
    note: F2
    duration: 12s
    gain: -13db
    env: a=0.8s d=1s s=0.85 r=2s
  }
  layer lead : notes {
    osc: morph
    scan: 0.45
    gain: -12db
    pan: -0.1
    humanize: 0.45
    velbright: 0.7
    vibrato: rate=5.4 depth=12c delay=0.3s
    env: a=0.04s d=0.4s s=0.65 r=0.6s
    play line @ 2b
  }
  layer bass : notes {
    osc: square
    gain: -13db
    env: a=0.01s d=0.2s s=0.7 r=0.15s
    notes: F1 @ 0b for 1.75b, F1 @ 2b for 1.75b, Ab1 @ 4b for 1.75b,
           C2 @ 6b for 1.75b, F1 @ 8b for 3.5b
  }
  layer kick : drums {
    voice: kick
    pattern: X...x...X...x...
    gain: -6db
    humanize: 0.3
  }
  layer hats : drums {
    voice: hat
    pattern: x.x.x.x.x.x.xxx.
    gain: -20db
    pan: 0.2
    humanize: 0.55
  }
  master { lufs: -15
           peak: -1db
           fadeout: 1s }
}

asset mix_produced {
  kind: cue
  duration: 12s
  tempo: 96bpm
  key: F minor
  groove: laidback 0.5

  motif line {
    F3 @ 0b for 1.5b vel 0.7
    Ab3 @ 2b for 1b vel 0.6
    C4 @ 3b for 1b vel 0.75
    Eb4 @ 4b for 2b vel 0.85
    C4 @ 6.5b for 1b vel 0.6
    F4 @ 8b for 3.5b vel 0.9
  }

  # pads+lead share one space and duck under the kick; drums get
  # transient snap and their own glue; EQ carves each voice a home.
  bus music {
    gain: -0.5db
    duck: source=kick amount=4.5db attack=0.012s release=0.16s threshold=-38db
    fx: peak(420hz, gain=-2.5, q=1.1), highshelf(7500hz, gain=1.5),
        hall(rt60=2.3s, damp=0.45, mix=0.22), saturate(amount=0.15, warmth=0.35)
  }
  bus drums_bus {
    fx: transient(attack=5, sustain=-2.5), peak(3200hz, gain=2, q=1.3),
        comp(threshold=-16, ratio=2.6, attack=0.008, release=0.11, knee=4, makeup=1.2),
        saturate(amount=0.18, warmth=0.5)
  }

  layer pad : tone {
    osc: pad
    note: F2
    duration: 12s
    gain: -13db
    bus: music
    env: a=0.8s d=1s s=0.85 r=2s
    fx: lowshelf(160hz, gain=-3), lowpass(3400hz)
  }
  layer lead : notes {
    osc: morph
    scan: 0.45
    gain: -12db
    pan: -0.1
    bus: music
    humanize: 0.45
    velbright: 0.7
    vibrato: rate=5.4 depth=12c delay=0.3s
    env: a=0.04s d=0.4s s=0.65 r=0.6s
    play line @ 2b
    fx: peak(1800hz, gain=2, q=1.2)
  }
  layer bass : notes {
    osc: square
    gain: -13db
    env: a=0.01s d=0.2s s=0.7 r=0.15s
    notes: F1 @ 0b for 1.75b, F1 @ 2b for 1.75b, Ab1 @ 4b for 1.75b,
           C2 @ 6b for 1.75b, F1 @ 8b for 3.5b
    fx: lowpass(700hz), peak(85hz, gain=1.5, q=0.9)
  }
  layer kick : drums {
    voice: kick
    pattern: X...x...X...x...
    gain: -6db
    bus: drums_bus
    humanize: 0.3
  }
  layer hats : drums {
    voice: hat
    pattern: x.x.x.x.x.x.xxx.
    gain: -20db
    pan: 0.2
    bus: drums_bus
    humanize: 0.55
    fx: highpass(2000hz)
  }
  master { lufs: -15
           peak: -1db
           fadeout: 1s
           fx: lowshelf(90hz, gain=1), highshelf(11000hz, gain=1),
               saturate(amount=0.1, warmth=0.25) }
}
