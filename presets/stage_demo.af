# P4 exit criterion — the Eroica test: a staged tutti with believable
# depth and width. Violin sections left and right of the conductor,
# timpani deep upstage center, all in the Lady Chapel, St Albans
# (OpenAIR, CC BY 4.0 — attribution in samples/*.ATTRIBUTION.txt),
# blended from close / tree / ambient taps.
asset eroica_staged {
  kind: soundtrack
  duration: 30s
  samplerate: 48000
  bitdepth: 24
  tempo: 72bpm
  key: A minor
  library: "vsco2-ce-subset@e4f0356b9e6d43fe3a68d23a4e34e16d2f8be35783c9f050bcc4ec53fa2c4137"

  marker phrase_peak @ 10s
  marker second_phrase @ 13.3s

  stage {
    hall: "stalbans_ortf_ir.wav@be670d833feaf274e601ad026b4f32f126c71fa8eb9b386e855ed9f0035410aa"
    mics: tree=0.72, close=0.22, ambient=0.4
    size: 15m, 23m, 12m
  }

  layer vln1 : instrument {
    instrument: violins_1
    section: size=8 spread=0.45 detune=7c timing=0.011s
    seat: -16deg @ 4.5m
    legato: 0.07s
    phrasing: 0.7
    gain: -8db
    humanize: 0.3
    dynamic: 0b=pp, 12b=f, 20b=mf, 30b=pp
    notes: slur( A3 @ 0b for 3b, C4 @ 3b for 2b, E4 @ 5b for 3b,
                 D5 @ 8b for 2b, B4 @ 10b for 2b, A4 @ 12b for 4b ),
           slur( G4 @ 16b for 2b, E4 @ 18b for 2b, C4 @ 20b for 3b,
                 A3 @ 23b for 9b )
  }
  layer vln2 : instrument {
    instrument: violins_1
    articulation: spiccato
    section: size=5 spread=0.35 detune=8c timing=0.012s
    seat: 14deg @ 5.5m
    gain: -13db
    humanize: 0.5
    dynamic: 0b=p, 12b=f, 22b=mp
    notes: A3 @ 12b for 0.5b, C4 @ 12.5b for 0.5b, E4 @ 13b for 0.5b,
           A4 @ 13.5b for 0.5b, E4 @ 14b for 0.5b, C4 @ 14.5b for 0.5b,
           A3 @ 16b for 0.5b, E4 @ 17b for 0.5b,
           A3 @ 20b for 0.5b art pizzicato, E4 @ 21b for 0.5b art pizzicato
  }
  layer timp : instrument {
    instrument: timpani
    seat: 4deg @ 12m
    gain: -8db
    humanize: 0.3
    dynamic: 0b=pp, 12b=ff, 24b=p
    notes: A2 @ 0b for 1b, A2 @ 12b for 1b, E2 @ 18b for 1b,
           A2 @ 23b for 1b
  }
  master {
    lufs: -17
    peak: -1db
    fadein: 0.3s
    fadeout: 3s
  }
}
