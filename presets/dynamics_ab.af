# P2 exit criterion A/B: the same notes twice.
# 'flat' = P1 behavior (fixed velocity, sustain only).
# 'performed' = dynamic hairpins driving time-varying velocity-layer
# crossfades + articulation marks (spiccato sampled; pizzicato, tremolo,
# marcato resolved through documented fallbacks recorded in the manifest).
asset eroica_flat {
  kind: soundtrack
  duration: 26s
  samplerate: 48000
  bitdepth: 24
  tempo: 76bpm
  key: A minor
  library: "vsco2-ce-subset@e4f0356b9e6d43fe3a68d23a4e34e16d2f8be35783c9f050bcc4ec53fa2c4137"

  bus strings { fx: hall(rt60=2.3s, damp=0.42, mix=0.24) }

  layer vln : instrument {
    instrument: violins_1
    gain: -7db
    bus: strings
    humanize: 0.3
    notes: A3 @ 0b for 8b vel 0.6, C4 @ 8b for 4b vel 0.6,
           E4 @ 12b for 6b vel 0.6, D5 @ 18b for 2b vel 0.6,
           B4 @ 20b for 4b vel 0.6, A3 @ 24b for 8b vel 0.6
  }
  layer timp : instrument {
    instrument: timpani
    gain: -10db
    humanize: 0.3
    notes: A2 @ 0b for 1b vel 0.6, A2 @ 12b for 1b vel 0.6,
           A2 @ 24b for 1b vel 0.6
  }
  master { lufs: -17
           peak: -1db
           fadein: 0.3s
           fadeout: 2s }
}

asset eroica_performed {
  kind: soundtrack
  duration: 26s
  samplerate: 48000
  bitdepth: 24
  tempo: 76bpm
  key: A minor
  library: "vsco2-ce-subset@e4f0356b9e6d43fe3a68d23a4e34e16d2f8be35783c9f050bcc4ec53fa2c4137"

  marker hairpin_peak @ 14.2s

  bus strings { fx: hall(rt60=2.3s, damp=0.42, mix=0.24) }

  layer vln : instrument {
    instrument: violins_1
    gain: -7db
    bus: strings
    humanize: 0.3
    dynamic: 0b=pp, 12b=ff, 18b=f, 24b=mp, 32b=pp
    notes: A3 @ 0b for 8b, C4 @ 8b for 4b,
           E4 @ 12b for 6b vel 1.05, D5 @ 18b for 2b art marcato,
           B4 @ 20b for 4b art tremolo, A3 @ 24b for 8b
  }
  layer vln_answer : instrument {
    instrument: violins_1
    articulation: spiccato
    gain: -12db
    pan: 0.2
    bus: strings
    humanize: 0.5
    dynamic: 0b=p, 12b=f, 20b=mf
    notes: A3 @ 12b for 0.5b, C4 @ 12.5b for 0.5b, E4 @ 13b for 0.5b,
           A4 @ 13.5b for 0.5b, E4 @ 14b for 0.5b, C4 @ 14.5b for 0.5b,
           A3 @ 16b for 0.5b art pizzicato, E4 @ 17b for 0.5b art pizzicato
  }
  layer timp : instrument {
    instrument: timpani
    gain: -10db
    humanize: 0.3
    dynamic: 0b=pp, 12b=ff, 24b=p
    notes: A2 @ 0b for 1b, A2 @ 12b for 1b, A2 @ 24b for 1b
  }
  master { lufs: -17
           peak: -1db
           fadein: 0.3s
           fadeout: 2s }
}
