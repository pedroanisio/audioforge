# Cinematic ambient cue — awe, tension, depth, emotional scale.
# Inspired by the *aesthetic* of cosmic sci-fi scoring (sustained organ-class
# harmony, a relentless pulse marking time, vast space, a long crescendo) —
# the harmony, motif, and structure here are original.
asset cosmic_awe_cue_v1 {
  kind: cue
  duration: 36s
  samplerate: 48000
  bitdepth: 24
  tempo: 60bpm
  key: C minor
  emotion: awe=0.9, tension=0.55, wonder=0.7, suspense=0.4, cinematic_intensity=0.8
  intensity: 0s=0.15, 8s=0.3, 16s=0.55, 26s=1.0, 31s=0.85, 36s=0.1

  marker scene_start @ 0s
  marker build_start @ 8s
  marker second_lift @ 16s
  marker climax @ 26s
  marker resolve @ 31s

  # original rising motif — answered an octave up at the climax
  motif ascent {
    C4 @ 0b for 1.5b vel 0.7
    Eb4 @ 1.5b for 1.5b vel 0.75
    G4 @ 3b for 2b vel 0.85
    Bb4 @ 5b for 3b vel 0.95
  }

  # vast low foundation
  layer deep_drone : notes {
    osc: organ
    gain: -9db
    loop: 16b
    env: a=4s d=2s s=0.85 r=5s
    notes: C2 @ 0b for 16b, G2 @ 0b for 16b
    fx: lowpass(900hz), reverb(decay=7s, mix=0.45)
    auto cutoff: 0s=400, 26s=2400, 36s=600
  }

  layer sub_anchor : tone {
    osc: sine
    note: C1
    gain: -10db
    env: a=3s d=4s s=0.8 r=6s
  }

  # sustained organ harmony, slowly blooming: Cm -> Ab -> Eb/G -> G sus
  layer organ_choir : notes {
    osc: organ
    gain: -12db
    pan: -0.15
    env: a=2.5s d=1s s=0.9 r=4s
    notes: C3 @ 0b for 8b, Eb3 @ 0b for 8b, G3 @ 0b for 8b,
           Ab2 @ 8b for 8b, C4 @ 8b for 8b, Eb4 @ 8b for 8b,
           Eb3 @ 16b for 8b, G3 @ 16b for 8b, Bb3 @ 16b for 8b,
           G2 @ 24b for 8b, D4 @ 24b for 8b, G4 @ 24b for 8b,
           C3 @ 32b for 4b, G3 @ 32b for 4b
    fx: reverb(decay=6s, mix=0.5)
    auto gain: 0s=-10db, 26s=0db, 33s=-8db
  }

  # the relentless pulse — short pitched ticks marking every beat
  layer time_pulse : notes {
    osc: fm
    fmratio: 5.04
    fmindex: 3
    gain: -19db
    pan: 0.25
    loop: 1b
    env: a=0.001s d=0.06s s=0 r=0.02s
    notes: E6 @ 0b for 0.25b
    fx: highpass(1200hz), delay(time=0.5s, feedback=0.25, mix=0.25),
        reverb(decay=2s, mix=0.3)
    auto gain: 0s=-6db, 16s=0db, 31s=-12db, 36s=-30db
  }

  # the ascent motif, then its octave answer at the climax
  layer motif_voice : notes {
    osc: sine
    detune: 5c
    gain: -11db
    pan: 0.1
    env: a=0.4s d=1.2s s=0.5 r=2s
    play ascent @ 10b
    play ascent @ 24b transpose +12st vel 1.1
    fx: delay(time=1s, feedback=0.3, mix=0.25), reverb(decay=5s, mix=0.45)
  }

  # high shimmer entering with the second lift
  layer shimmer : tone {
    osc: organ
    note: G5
    start: 16s
    duration: 18s
    gain: -22db
    pan: -0.3
    env: a=5s d=4s s=0.6 r=6s
    fx: tremolo(rate=0.4, depth=0.5), reverb(decay=8s, mix=0.6)
  }

  master {
    width: 0.85
    lufs: -16
    peak: -1db
    fadein: 0.6s
    fadeout: 3s
    fx: highpass(28hz)
  }
}
