# ACTION — 148 bpm trailer chase: driving drums, braam stabs, ostinato
# strings, sub impact at the hit point. Tight plate, no wash.
asset vibe_action_v1 {
  kind: cue
  duration: 13s
  tempo: 148bpm
  key: D minor
  emotion: urgency=0.9, tension=0.8, cinematic_intensity=0.9
  intensity: 0s=0.6, 6.5s=0.8, 9.7s=1.0, 13s=0.7

  marker hit @ 9.73s

  layer kick : drums {
    voice: kick
    pattern: X..xX..xX..xX.xx
    gain: -1db
  }
  layer snare : drums {
    voice: snare
    pattern: ....X.......X..X
    gain: -5db
  }
  layer hat : drums {
    voice: hat
    pattern: x.xxx.xxx.xxx.xx
    gain: -14db
    pan: 0.25
  }
  layer tom_drive : drums {
    voice: tom
    pattern: ..x...x...x..xxx
    gain: -8db
    pan: -0.2
  }
  layer ostinato : notes {
    osc: pluck
    damping: 0.45
    brightness: 0.9
    gain: -10db
    pan: 0.15
    loop: 4b
    env: a=0.001s d=0.3s s=0.2 r=0.05s
    notes: D3 @ 0b for 0.5b, D3 @ 0.5b for 0.5b vel 0.7, F3 @ 1b for 0.5b,
           D3 @ 1.5b for 0.5b vel 0.7, A3 @ 2b for 0.5b, G3 @ 2.5b for 0.5b vel 0.8,
           F3 @ 3b for 0.5b, E3 @ 3.5b for 0.5b vel 0.7
    fx: bandpass(900hz, q=0.6), drive(0.25)
  }
  layer braam : notes {
    osc: saw
    unison: 7
    spread: 30c
    gain: -8db
    env: a=0.08s d=1.2s s=0.4 r=0.4s
    notes: D2 @ 0b for 3b, D2 @ 8b for 3b vel 0.9, C2 @ 16b for 3b,
           D2 @ 24b for 7b vel 1.1
    fx: lowpass(1100hz), drive(0.45), plate(decay=0.6, damp=0.5, mix=0.18)
  }
  layer impact : sweep {
    shape: sine
    from: 150hz
    to: 36hz
    curve: exp
    start: 9.73s
    duration: 1.4s
    gain: -3db
    env: a=0.002s d=1.1s s=0 r=0.2s
    fx: drive(0.4)
  }
  layer rise : noise {
    color: white
    start: 7.7s
    duration: 2s
    gain: -12db
    env: a=1.9s d=0.1s s=0 r=0.05s
    fx: bandpass(1200hz, q=0.8)
    auto cutoff: 7.7s=500, 9.7s=7000
  }
  master {
    width: 0.7
    lufs: -13
    peak: -1db
    fadeout: 0.6s
    fx: highpass(32hz)
  }
}
