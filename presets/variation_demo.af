# v2.8 variation at scale: this single spec is a PACK FACTORY.
# `audioforge pack` renders N siblings — vary() picks different drum
# patterns, textures, and arp shapes per variant tag, and every seeded
# path (grains, humanize, pads, dither) re-realizes coherently.
# `audioforge campaign` renders the declared cutdown matrix.
asset ember_campaign_cue {
  kind: soundtrack
  duration: 30s
  samplerate: 48000
  bitdepth: 24
  tempo: 102bpm, 36b=102bpm, 40b=118bpm
  key: C minor
  groove: vary(laidback 0.5, pushed 0.4, straight 1)
  intensity: 0s=0.3, 10s=0.55, 18s=0.95, 26s=0.7, 30s=0.35

  marker bed @ 0s
  marker build @ 10s
  marker peak @ 18s
  marker resolve @ 26s

  cutdowns {
    15s: keep 0s to 5.5s, keep 19.5s to 30s, fade 0.5s
    6s: keep 23.5s to 30s, fade 0.5s
  }

  motif hook {
    C4 @ 0b for 1b vel 0.75
    Eb4 @ 1.5b for 0.5b vel 0.6
    G4 @ 2b for 1.5b vel 0.85
    F4 @ 4b for 1b vel 0.62
    C4 @ 5b for 3b vel 0.78
  }

  bus music {
    duck: source=pulse amount=4db attack=0.012s release=0.15s threshold=-36db
    fx: peak(420hz, gain=-2, q=1.1), hall(rt60=2.2s, damp=0.45, mix=0.22),
        saturate(amount=0.14, warmth=0.35)
  }
  bus drums_bus {
    fx: transient(attack=4.5, sustain=-2), comp(threshold=-16, ratio=2.4, attack=0.009, release=0.12, knee=4, makeup=1.1)
  }

  layer harmony : notes {
    osc: pad
    gain: -15db
    bus: music
    env: a=0.6s d=0.8s s=0.8 r=1.8s
    notes: C3min7 @ 0b for 12b vel 0.55 voicing open,
           Ab2maj7 @ 12b for 8b vel 0.6 voicing spread,
           F2min7 @ 20b for 8b vel 0.6 voicing drop2,
           C3min7 @ 28b for 14b vel 0.7 voicing open
  }
  layer arpeggio : notes {
    osc: pluck
    damping: vary(0.4, 0.6)
    brightness: 0.72
    gain: -17db
    pan: 0.2
    bus: music
    humanize: 0.5
    velbright: 0.7
    arp: vary(updown rate=0.25b octaves=2 gate=0.8, up rate=0.5b octaves=1 gate=0.9)
    env: a=0.003s d=0.25s s=0.15 r=0.4s
    notes: C4min7 @ 0b for 12b vel 0.6, Ab3maj7 @ 12b for 8b vel 0.65,
           F3min7 @ 20b for 8b vel 0.7, C4min7 @ 28b for 14b vel 0.8
  }
  layer hookline : notes {
    osc: morph
    scan: 0.4
    gain: -12db
    pan: -0.1
    bus: music
    humanize: 0.45
    velbright: 0.75
    vibrato: rate=5.4 depth=11c delay=0.3s
    env: a=0.04s d=0.4s s=0.6 r=0.6s
    play hook @ 8b
    play hook @ 18b diatonic +2 vel 1.1
    play hook @ 28b vel 1.2
    play hook @ 38b stretch 0.75 vel 0.9
    auto scan: 0s=0.3, 18s=0.7, 30s=0.25
  }
  layer shimmer : grain {
    source: pad
    note: C5
    srcdur: 1.5s
    grainsize: vary(0.06s, 0.11s)
    density: vary(40, 60)
    pitchspread: 30c
    scatter: 0.6
    duration: 30s
    gain: -22db
    pan: 0.28
    bus: music
    env: a=2s d=2s s=0.7 r=3s
    fx: highpass(900hz)
  }
  layer pulse : drums {
    voice: kick
    pattern: vary(X...x...X...x..., X..x..x.X...x..., X.....x.X.x.....)
    gain: -7db
    bus: drums_bus
    humanize: 0.35
  }
  layer tick : drums {
    voice: hat
    pattern: vary(euclid(7,16,1), euclid(5,16), x.x.x.x.x.x.x.x.)
    gain: -21db
    pan: 0.24
    bus: drums_bus
    humanize: 0.6
    fx: highpass(1900hz)
  }
  master {
    width: 0.78
    lufs: -16
    peak: -1db
    fadein: 0.4s
    fadeout: 2s
    fx: lowshelf(95hz, gain=1), highshelf(10500hz, gain=1.2),
        saturate(amount=0.1, warmth=0.25)
  }
}
