# SLOW — 54 bpm, sparse felt keys over a breathing pad, huge soft room.
# Grief-adjacent warmth; everything unhurried.
asset vibe_slow_v1 {
  kind: bed
  duration: 18s
  tempo: 54bpm
  key: F major
  emotion: sadness=0.6, intimacy=0.8, calm=0.7
  intensity: 0s=0.35, 11s=0.6, 18s=0.2

  marker breath @ 11s

  layer felt_keys : notes {
    osc: fm
    fmratio: 1
    fmindex: 0.6
    gain: -10db
    env: a=0.04s d=2.8s s=0 r=1.5s
    notes: A3 @ 0b for 3b vel 0.7, F4 @ 2b for 3b vel 0.55,
           C4 @ 5b for 3b vel 0.65, D4 @ 9b for 4b vel 0.75,
           A3 @ 13b for 3b vel 0.5
    fx: lowpass(2200hz), plate(decay=0.86, damp=0.45, predelay=0.03, mix=0.34)
  }
  layer breath_pad : notes {
    osc: pad
    bandwidth: 35c
    gain: -15db
    pan: -0.2
    env: a=3.5s d=2s s=0.85 r=4s
    notes: F2 @ 0b for 9b, C3 @ 0b for 9b,
           D2 @ 9b for 8b, A2 @ 9b for 8b
    fx: lowpass(1100hz)
  }
  layer air : noise {
    color: brown
    gain: -32db
    env: a=4s d=6s s=0.7 r=4s
    fx: lowpass(700hz), tremolo(rate=0.09, depth=0.5)
  }
  master {
    width: 0.8
    lufs: -19
    peak: -2db
    fadein: 1.2s
    fadeout: 3s
    fx: fdn(rt60=6.5, rt60_high=2, crossover=1800, size=1.4, mix=0.24)
  }
}
