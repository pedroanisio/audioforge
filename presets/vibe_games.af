# GAMES — 140 bpm chiptune loop: square lead hook, triangle bass,
# noise hats, arpeggio sparkle. Loop-safe 2 bars, almost dry.
asset vibe_games_v1 {
  kind: loop
  duration: 6.857142857142857s
  tempo: 140bpm
  loopsafe: on
  key: C major
  emotion: triumph=0.6

  motif hook {
    C5 @ 0b for 0.5b
    E5 @ 0.5b for 0.5b vel 0.9
    G5 @ 1b for 0.75b
    E5 @ 2b for 0.5b vel 0.8
    A5 @ 2.5b for 0.75b vel 1.0
    G5 @ 3.5b for 0.5b vel 0.9
  }

  layer lead : notes {
    osc: square
    gain: -9db
    env: a=0.002s d=0.12s s=0.55 r=0.04s
    play hook @ 0b
    play hook @ 4b transpose +0st vel 0.9
    play hook @ 8b transpose +5st
    play hook @ 12b transpose +7st vel 1.05
    fx: delay(time=0.2143s, feedback=0.2, mix=0.15)
  }
  layer tri_bass : notes {
    osc: triangle
    gain: -8db
    loop: 4b
    env: a=0.002s d=0.1s s=0.7 r=0.03s
    notes: C2 @ 0b for 0.9b, C2 @ 1b for 0.9b vel 0.8, G1 @ 2b for 0.9b,
           A1 @ 3b for 0.9b vel 0.9
  }
  layer arp_sparkle : notes {
    osc: square
    gain: -19db
    pan: 0.3
    loop: 1b
    env: a=0.001s d=0.05s s=0.2 r=0.02s
    notes: C6 @ 0b for 0.25b vel 0.7, E6 @ 0.25b for 0.25b vel 0.55,
           G6 @ 0.5b for 0.25b vel 0.7, E6 @ 0.75b for 0.25b vel 0.5
  }
  layer chip_kick : drums {
    voice: kick
    pattern: X...x...X...x...
    gain: -4db
  }
  layer chip_hat : drums {
    voice: hat
    pattern: ..x...x...x...xx
    gain: -17db
    pan: -0.2
  }
  layer chip_snare : drums {
    voice: snare
    pattern: ....X.......X...
    gain: -9db
  }
  master {
    width: 0.5
    lufs: -14
    peak: -1db
    fadeout: 0.005s
  }
}
