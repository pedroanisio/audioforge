# SPEED — 174 bpm chase: breakbeat drums, 16th-note arp engine, rising
# filter energy. Drum'n'bass DNA, racing-game telemetry.
asset vibe_speed_v1 {
  kind: cue
  duration: 11s
  tempo: 174bpm
  key: A minor
  emotion: urgency=1.0, tension=0.5

  marker boost @ 5.5s

  layer kick : drums {
    voice: kick
    pattern: X.........X.....
    gain: -2db
  }
  layer snare : drums {
    voice: snare
    pattern: ....X..x..x.X..x
    gain: -6db
  }
  layer hat : drums {
    voice: hat
    pattern: xxxxxxxxxxxxxxxx
    gain: -16db
    pan: 0.2
  }
  layer bass_engine : notes {
    osc: saw
    unison: 3
    spread: 10c
    gain: -9db
    loop: 4b
    env: a=0.002s d=0.15s s=0.6 r=0.04s
    notes: A1 @ 0b for 1.5b, A1 @ 2b for 0.5b vel 0.8, C2 @ 2.5b for 0.5b,
           G1 @ 3b for 1b vel 0.9
    fx: lowpass(900hz), drive(0.35)
  }
  layer arp : notes {
    osc: square
    gain: -15db
    pan: -0.15
    loop: 2b
    env: a=0.001s d=0.08s s=0.3 r=0.03s
    notes: A4 @ 0b for 0.25b, C5 @ 0.25b for 0.25b vel 0.8, E5 @ 0.5b for 0.25b,
           A5 @ 0.75b for 0.25b vel 0.9, E5 @ 1b for 0.25b, C5 @ 1.25b for 0.25b vel 0.8,
           E5 @ 1.5b for 0.25b, G5 @ 1.75b for 0.25b vel 0.85
    fx: lowpass(2000hz), delay(time=0.1724s, feedback=0.25, mix=0.2)
    auto cutoff: 0s=800, 5.5s=6000, 11s=6000
  }
  layer wind : noise {
    color: pink
    gain: -22db
    env: a=2s d=4s s=0.6 r=1s
    fx: highpass(2500hz)
    auto gain: 0s=-10db, 5.5s=0db, 11s=-4db
  }
  master {
    width: 0.65
    lufs: -13
    peak: -1db
    fadeout: 0.4s
    fx: highpass(34hz)
  }
}
