# COMEDY — 112 bpm, bouncy swing, pizzicato + marimba + tuba-ish square
# bass, a cartoon slide on the punchline marker. Major key, dry-ish room.
asset vibe_comedy_v1 {
  kind: cue
  duration: 10s
  tempo: 112bpm
  swing: 0.28
  key: G major
  emotion: triumph=0.3, calm=0.2

  marker punchline @ 7.5s

  motif sneak {
    G3 @ 0b for 0.45b vel 0.9
    B3 @ 1b for 0.45b vel 0.7
    D4 @ 2b for 0.45b vel 0.85
    B3 @ 3b for 0.45b vel 0.6
  }

  layer pizz : notes {
    osc: pluck
    damping: 0.25
    brightness: 0.75
    pluckpos: 0.12
    gain: -7db
    env: a=0.001s d=0.5s s=0 r=0.1s
    play sneak @ 0b
    play sneak @ 4b transpose +2st
    play sneak @ 8b transpose +4st vel 1.1
    play sneak @ 12b transpose -1st vel 0.9
    fx: hall(rt60=0.9, damp=0.3, mix=0.18)
  }
  layer tuba : notes {
    osc: square
    gain: -13db
    loop: 4b
    env: a=0.01s d=0.3s s=0.3 r=0.08s
    notes: G1 @ 0b for 0.6b, D2 @ 2b for 0.6b vel 0.8
    fx: lowpass(420hz)
  }
  layer marimba_wink : notes {
    osc: modal
    material: marimba
    modedecay: 0.8s
    gain: -11db
    pan: 0.3
    env: a=0.001s d=0.6s s=0 r=0.2s
    notes: B4 @ 3.5b for 0.5b vel 0.8, D5 @ 7.5b for 0.5b vel 0.9,
           G5 @ 11.5b for 0.5b vel 1.0, F#5 @ 15.5b for 0.5b vel 0.7
    fx: hall(rt60=1.1, mix=0.2)
  }
  layer woodtick : drums {
    voice: hat
    pattern: x.x.x.xxx.x.x.x.
    gain: -18db
    pan: -0.3
  }
  layer slide : sweep {
    shape: sine
    from: 1500hz
    to: 320hz
    curve: exp
    start: 7.5s
    duration: 0.9s
    gain: -10db
    env: a=0.05s d=0.7s s=0 r=0.1s
  }
  master {
    width: 0.6
    lufs: -15
    peak: -1db
    fadeout: 0.5s
  }
}
