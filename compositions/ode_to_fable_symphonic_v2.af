    play prog_I1 @ 28b vel 0.46
    play prog_III1 @ 140b vel 0.50
    play prog_III2 @ 156b vel 0.52
    play prog_III1 @ 180b vel 0.52
    play prog_IV1 @ 224b vel 0.66
    play prog_IV2 @ 240b vel 0.70
    play prog_IV1 @ 256b vel 0.60
  }

  layer glockenspiel : instrument {
    instrument:   "Glockenspiel"
    articulation: sustain
    seat:         -8deg @ 9.6m
    dynamic:      140b=mp, 224b=f

    # held back from the quiet arrival; only crowns the EARNED triumph
    notes: A5 @ 140b for 2b vel 0.46, D6 @ 156b for 2b vel 0.48,
           D6 @ 224b for 2b vel 0.62, A6 @ 240b for 2b vel 0.66,
           A6 @ 248b for 4b vel 0.70
  }

  layer tubular : instrument {
    instrument:   "TubularBells"
    articulation: sustain
    dynamic:      224b=f, 248b=ff
    seat:         +8deg @ 9.6m

    # bells withheld until the triumph is earned (not at the quiet arrival)
    notes: D5 @ 224b for 4b vel 0.78, A4 @ 232b for 4b vel 0.70,
           D5 @ 240b for 8b vel 0.84, A4 @ 248b for 8b vel 0.74,
           D5 @ 264b for 8b vel 0.70
  }

  # ===========================================================================
  # PERCUSSION (synth) — only a depths heartbeat; the build is now orchestral.
  # ===========================================================================
  layer heartbeat : drums {
    voice:   tom
    tune:    -7st
    decay:   1.6
    pattern: X.......x.......
    start:   1s
    duration: 16s
    gain:    -13db
    fx:      lowpass(170hz), reverb(decay=2.4, mix=0.18)
    auto gain: 1s=-22db, 9s=-15db, 16s=-22db
  }

  # ===========================================================================
  # MASTER
  # ===========================================================================
  master {
    width:   0.85
    lufs:    -16
    peak:    -1.0
    fadein:  1.5s
    fadeout: 6.5s

    fx: comp(threshold=-17, ratio=2.0, attack=0.02, release=0.25, knee=9, makeup=1),
        highpass(28hz),
        lowshelf(110hz, gain=-1.0),
        highshelf(9000hz, gain=+0.6),
        mbcomp(threshold=-20, ratio=1.8, low=170, high=2700)
  }

}

